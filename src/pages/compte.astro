---
import Base from '../layouts/Base.astro';
import ClasseChamps from '../components/ClasseChamps.astro';
---
<Base title="Mon espace" noindex>
  <header class="me-head">
    <div class="container me-head-in">
      <div class="me-id">
        <p class="me-k">Mon espace · Parlement JPV</p>
        <h1 id="hello">Mon espace</h1>
        <ul class="me-etats" aria-label="État de mon compte">
          <li><a href="#notifCard" id="chipNotif">Notifications : …</a></li>
          <li><a href="#certCard" id="chipCert">Certificat : …</a></li>
        </ul>
      </div>
      <div class="me-actions"><a class="btn btn-sm me-btn-bureau hidden" id="bureauLink" href="/bureau">Espace bureau</a><button class="btn btn-sm me-btn-out" id="logout" type="button">Se déconnecter</button></div>
    </div>
  </header>

  <section class="section me-page"><div class="container">
    <div class="me-urgent">
      <a class="vote-alerte hidden" id="voteAlerte" href="/elections"></a>
      <div class="card hidden" id="welcome"></div>
      <div class="me-urgent-grid">
        <div class="card mo-card hidden" id="moVote"></div>
        <div class="card mo-card hidden" id="moLaureat"></div>
        <div class="card mo-card hidden" id="tnCard"></div>
      </div>
    </div>

    <div class="me-layout">
      <div class="me-main">
        <section class="card me-seances" aria-labelledby="tSeances">
          <div class="me-sec-h"><h2 id="tSeances">Prochaines séances</h2><a class="small" href="/evenement">Tout l'agenda</a></div>
          <p class="muted small">Réponds en un clic : le bureau sait à l'avance combien vous serez.</p>
          <div id="events"><p class="muted small">Chargement…</p></div>
        </section>

        <section class="me-participer" aria-labelledby="tParticiper">
          <h2 class="me-titre" id="tParticiper">Participer</h2>
          <div class="me-tuiles">
            <a class="tuile" href="/motions"><span class="tuile-k">Motions</span><strong id="tMotions">Propose et soutiens les sujets des prochains débats</strong><span class="tuile-go" aria-hidden="true">→</span></a>
            <a class="tuile hidden" id="tuileVote" href="/elections"><span class="tuile-k">Vote</span><strong id="tVote">Élections du bureau à bulletin secret</strong><span class="tuile-go" aria-hidden="true">→</span></a>
            <a class="tuile" href="/sondages"><span class="tuile-k">Sondages</span><strong id="tSondages">Donne ton avis au bureau en un clic</strong><span class="tuile-go" aria-hidden="true">→</span></a>
            <a class="tuile" href="/sorties"><span class="tuile-k">Sorties et visites</span><strong id="tSorties">Assemblée, Sénat, tribunal : inscris-toi aux prochaines sorties</strong><span class="tuile-go" aria-hidden="true">→</span></a>
            <a class="tuile" href="/tournoi"><span class="tuile-k">Tournoi d'éloquence</span><strong>Affronte les autres orateurs en duel</strong><span class="tuile-go" aria-hidden="true">→</span></a>
            <a class="tuile" href="/profil"><span class="tuile-k">Profil d'orateur</span><strong id="tProfil">Tes séances, tes rôles et tes badges</strong><span class="tuile-go" aria-hidden="true">→</span></a>
            <a class="tuile" href="/ecrire-au-bureau"><span class="tuile-k">Écrire au bureau</span><strong>Contacter un membre du bureau ou déposer une idée anonyme</strong><span class="tuile-go" aria-hidden="true">→</span></a>
          </div>
        </section>
      </div>

      <aside class="me-side" aria-label="Rester informé">
        <a class="card me-wa" href="https://chat.whatsapp.com/DgbCKPKUfR17UUqv4DIPoI" target="_blank" rel="noopener">
          <span class="me-wa-k">Groupe WhatsApp</span>
          <strong>Rejoins le groupe du Parlement</strong>
          <span class="small">Toutes les infos au quotidien : séances, sujets, changements de dernière minute.</span>
          <span class="me-wa-go">Rejoindre le groupe</span>
        </a>
        <div class="card" id="notifCard">
          <h3>Notifications sur mon téléphone</h3>
          <p class="small muted" id="notifTxt">Nouvelles séances, rappel la veille, votes : reçois une alerte comme un SMS.</p>
          <div class="flex" style="gap:8px;flex-wrap:wrap;">
            <button class="btn btn-primary btn-sm hidden" id="notifOn" type="button">Activer les notifications</button>
            <button class="btn btn-outline btn-sm hidden" id="notifOff" type="button">Désactiver sur cet appareil</button>
            <a class="btn btn-outline btn-sm hidden app-hide" id="notifInstall" href="/application">Installer l'application</a>
          </div>
          <div id="notifMsg" aria-live="polite"></div>
        </div>
        <details class="card cert-card" id="certCard" open>
          <summary><span class="cert-sum"><span class="cert-t">Certificat de membre</span><span class="small muted" id="certEtat">À signer</span></span><span class="cert-chev" aria-hidden="true"></span></summary>
          <p class="small muted">Un PDF officiel signé par toi et par la présidence, qui atteste que tu es membre du Parlement JPV. Son QR code permet à n'importe qui de vérifier qu'il est authentique. Utile pour Parcoursup, un CV ou une candidature.</p>
          <div class="sig-apercu hidden" id="sigApercu"><span class="small muted">Ma signature</span><img id="sigImg" alt="Ta signature" /></div>
          <div class="flex" style="gap:8px;flex-wrap:wrap;">
            <button class="btn btn-primary btn-sm" id="certif" type="button">Télécharger mon certificat (PDF)</button>
            <button class="btn btn-outline btn-sm" id="sigEdit" type="button">Signer mon certificat</button>
          </div>
          <div id="certifMsg" aria-live="polite"></div>
        </details>
        <div class="card me-cand">
          <h3>Mes candidatures</h3>
          <div id="cand"><p class="muted small">Chargement…</p></div>
        </div>
      </aside>
    </div>

    <section class="me-compte" aria-labelledby="tCompte">
      <h2 class="me-titre" id="tCompte">Mon compte</h2>
      <div class="card me-reglages">
        <div class="me-r">
          <div class="me-r-h"><h3>Mes informations</h3><p class="small muted">Nom, classe, téléphone. Ton email sert d'identifiant.</p></div>
          <div class="me-r-b">
            <button class="btn btn-outline btn-sm" id="editInfos" type="button" aria-expanded="false" aria-controls="profileForm">Modifier mes informations</button>
            <form class="form hidden" id="profileForm">
              <div class="form-row">
                <div class="field"><label for="prenom">Prénom</label><input id="prenom" name="prenom" required /></div>
                <div class="field"><label for="nom">Nom</label><input id="nom" name="nom" required /></div>
              </div>
              <div class="form-row">
                <ClasseChamps prefix="p-" />
                <div class="field"><label for="telephone">Téléphone</label><input id="telephone" name="telephone" type="tel" autocomplete="tel" inputmode="tel" pattern="[+0-9 .()\-]{8,20}" placeholder="06 12 34 56 78" /></div>
              </div>
              <div class="field"><label>Email</label><input id="email" disabled /></div>
              <div id="pmsg"></div>
              <div class="flex" style="gap:8px;"><button class="btn btn-primary btn-sm" type="submit">Enregistrer</button><button class="btn btn-outline btn-sm" id="cancelInfos" type="button">Annuler</button></div>
            </form>
          </div>
        </div>
        <div class="me-r">
          <div class="me-r-h"><h3>Emails</h3><p class="small muted" id="amsg">Les emails liés à tes inscriptions (confirmation, annulation) restent envoyés.</p></div>
          <div class="me-r-b"><label class="checkbox"><input type="checkbox" id="annonces" /><span>Recevoir un email à chaque nouvelle séance publiée</span></label></div>
        </div>
        <div class="me-r">
          <div class="me-r-h"><h3>Mot de passe</h3><p class="small muted">Tu recevras un lien par email pour en choisir un nouveau.</p></div>
          <div class="me-r-b"><a class="btn btn-outline btn-sm" href="/mot-de-passe-oublie">Changer mon mot de passe</a></div>
        </div>
        <div class="me-r me-r-danger">
          <div class="me-r-h"><h3>Supprimer mon compte</h3><p class="small muted">Supprime ton profil, tes inscriptions et tes candidatures. Irréversible.</p></div>
          <div class="me-r-b"><button class="btn btn-outline btn-sm" id="delAccount" type="button">Supprimer définitivement</button></div>
        </div>
      </div>
    </section>
  </div></section>
</Base>
<style is:global>
  .me-head { background: var(--nuit); color: #fff; border-bottom: 6px solid var(--rouge); }
  .me-head-in { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; padding-top: clamp(28px, 5vw, 48px); padding-bottom: clamp(22px, 4vw, 34px); }
  .me-k { margin: 0 0 6px; font-weight: 700; font-size: 0.9rem; color: #ff8a95; }
  .me-head h1 { color: #fff; margin: 0; font-size: clamp(2.2rem, 6vw, 3.6rem); line-height: 1; letter-spacing: -0.03em; }
  .me-etats { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0 0; padding: 0; }
  .me-etats a { display: inline-block; color: #fff; text-decoration: none; font-size: 0.85rem; font-weight: 700; padding: 6px 12px; border: 2px solid rgba(255,255,255,0.35); border-radius: 999px; }
  .me-etats a.ok { border-color: #5fd38d; }
  .me-etats a.todo { border-color: #ff8a95; background: rgba(214,40,57,0.25); }
  .me-etats a:hover { background: rgba(255,255,255,0.12); }
  .me-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .me-actions .btn.hidden { display: none; }
  .me-btn-bureau { background: var(--rouge); color: #fff; border: 2px solid var(--rouge); }
  .me-btn-out { background: transparent; color: #fff; border: 2px solid rgba(255,255,255,0.5); }
  .me-btn-out:hover { background: rgba(255,255,255,0.12); }
  .me-page { padding-top: 28px; }
  .me-urgent { display: grid; gap: 16px; }
  .me-urgent:has(> :not(.hidden)) { margin-bottom: 28px; }
  .me-urgent-grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .me-urgent-grid:not(:has(> :not(.hidden))) { display: none; }
  .me-layout { display: grid; gap: 28px; grid-template-columns: minmax(0, 1fr); align-items: start; }
  @media (min-width: 960px) { .me-layout { grid-template-columns: minmax(0, 1.75fr) minmax(300px, 1fr); gap: 36px; } .me-side { position: sticky; top: 90px; } }
  .me-main, .me-side { display: grid; gap: 20px; align-content: start; }
  @media (max-width: 959px) { .me-main, .me-side { display: contents; } .me-seances { order: 1; } .me-wa { order: 2; } .me-participer { order: 3; } #notifCard { order: 4; } #certCard { order: 5; } .me-cand { order: 6; } }
  .me-page .card { border-radius: 12px; }
  .me-sec-h { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .me-sec-h h2 { margin: 0; font-size: 1.6rem; }
  .me-sec-h a { font-weight: 700; color: var(--rouge); }
  .me-seances { border-top: 6px solid var(--rouge); }
  .me-seances #events .event:last-child { border-bottom: 0; }
  .me-titre { font-size: 1.35rem; margin: 8px 0 12px; }
  .me-tuiles { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  a.tuile { position: relative; display: grid; align-content: start; gap: 6px; padding: 16px 44px 16px 16px; background: var(--blanc); border: 2px solid var(--pierre); border-radius: 12px; color: var(--nuit); text-decoration: none; transition: border-color 0.15s ease, transform 0.15s ease; }
  a.tuile.hidden { display: none; }
  a.tuile * { text-decoration: none; }
  a.tuile:hover { border-color: var(--nuit); transform: translateY(-2px); }
  a.tuile:focus-visible { outline: 3px solid var(--rouge); outline-offset: 3px; }
  a.tuile .tuile-k { font-weight: 800; font-size: 0.8rem; color: var(--rouge); }
  a.tuile strong { font-size: 1rem; line-height: 1.3; }
  a.tuile .tuile-go { position: absolute; right: 14px; top: 14px; font-weight: 800; font-size: 1.2rem; color: var(--rouge); }
  a.tuile.tuile-chaud { border-color: var(--rouge); background: var(--rouge); color: #fff; }
  a.tuile.tuile-chaud .tuile-k, a.tuile.tuile-chaud .tuile-go { color: #fff; }
  .me-wa { display: grid; gap: 6px; text-decoration: none; color: var(--nuit); background: #e8f8ee; border: 2px solid #25d366; }
  .me-wa * { text-decoration: none; }
  .me-wa-k { font-weight: 800; font-size: 0.8rem; color: #128c4b; }
  .me-wa strong { font-size: 1.2rem; line-height: 1.2; }
  .me-wa-go { justify-self: start; margin-top: 6px; background: #25d366; color: #fff; font-weight: 800; padding: 9px 16px; border-radius: 8px; }
  .me-wa:hover .me-wa-go { background: #128c4b; }
  .me-wa:focus-visible { outline: 3px solid #128c4b; outline-offset: 3px; }
  .me-compte { margin-top: 44px; }
  .me-reglages { padding: 0; }
  .me-r { display: grid; gap: 12px; padding: 20px 22px; border-top: 1px solid var(--pierre); }
  .me-r:first-child { border-top: 0; }
  @media (min-width: 760px) { .me-r { grid-template-columns: 260px 1fr; gap: 28px; align-items: start; } }
  .me-r-h h3 { margin: 0 0 4px; font-size: 1.05rem; }
  .me-r-h p { margin: 0; }
  .me-r-b .form { margin: 0; }
  .me-r-danger h3 { color: var(--err); }
  .me-r-danger .btn { border-color: var(--err) !important; color: var(--err) !important; }
  @media (prefers-reduced-motion: reduce) { a.tuile { transition: none; } a.tuile:hover { transform: none; } }
  .cert-card { padding-top: 0; padding-bottom: 0; }
  .cert-card > summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 18px 0; }
  .cert-card > summary::-webkit-details-marker { display: none; }
  .cert-card > summary:focus-visible { outline: 3px solid var(--rouge); outline-offset: 4px; }
  .cert-sum { display: grid; gap: 2px; }
  .cert-t { font-size: 1.25rem; font-weight: 800; line-height: 1.15; }
  .cert-chev { flex: none; width: 12px; height: 12px; border-right: 3px solid var(--nuit); border-bottom: 3px solid var(--nuit); transform: rotate(45deg); margin-top: -6px; transition: transform 0.15s ease; }
  .cert-card[open] > summary .cert-chev { transform: rotate(-135deg); margin-top: 4px; }
  .cert-card[open] { padding-bottom: 20px; }
  @media (prefers-reduced-motion: reduce) { .cert-chev { transition: none; } }
  .sig-apercu { display: grid; gap: 4px; margin: 4px 0 12px; }
  .sig-apercu img { max-width: 220px; max-height: 70px; object-fit: contain; object-position: left; background: #fff; padding: 4px 8px; border-bottom: 2px solid var(--nuit); }
  .mo-card { border: 3px solid var(--nuit); border-radius: 12px; }
  .mo-card .mo-k { font-weight: 800; color: var(--rouge); font-size: 0.9rem; margin: 0 0 4px; }
  .mo-card h3 { margin: 0 0 6px; }
  .mo-liste { display: grid; gap: 8px; margin: 14px 0 10px; }
  .mo-opt { display: flex; align-items: center; justify-content: space-between; gap: 10px; width: 100%; text-align: left; padding: 10px 14px; border: 2px solid var(--nuit); background: transparent; color: inherit; font: inherit; cursor: pointer; }
  .mo-opt:hover { background: var(--pierre); }
  .mo-opt:focus-visible { outline: 3px solid var(--rouge); outline-offset: 2px; }
  .mo-opt.choisi { background: var(--nuit); color: #fff; }
  .mo-opt.choisi .muted { color: rgba(255,255,255,0.75); }
  a.vote-alerte { display: grid; border-radius: 12px; gap: 6px; padding: 22px 24px; background: var(--rouge); color: #fff; text-decoration: none; border: 3px solid var(--rouge); }
  a.vote-alerte.hidden { display: none; }
  a.vote-alerte * { color: #fff; text-decoration: none; }
  a.vote-alerte .va-k { font-weight: 800; font-size: 0.9rem; }
  a.vote-alerte strong { display: block; font-size: clamp(1.6rem, 4vw, 2.2rem); line-height: 1.05; letter-spacing: -0.02em; }
  a.vote-alerte .va-go { justify-self: start; margin-top: 6px; background: #fff; color: var(--rouge); font-weight: 800; padding: 8px 16px; }
  a.vote-alerte:hover .va-go { background: var(--nuit); color: #fff; }
  a.vote-alerte:focus-visible { outline: 3px solid var(--nuit); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { a.card.tuile { transition: none; } a.card.tuile:hover { transform: none; } }
</style>
<script>
  import { u } from '../lib/url';
  import { api, postJSON } from '../lib/newsletter';
  import { getSupabase } from '../lib/supabase';
  import { requireSession, getProfile, signOut } from '../lib/auth';
  import { fetchUpcoming, fmt, when, esc } from '../lib/events';
  import { etatPush, activerPush, desactiverPush, estApp } from '../lib/push';
  import { telechargerCertificat } from '../lib/certificat';
  import { demanderSignature } from '../lib/signature';
  import { lireClasse, remplirClasse } from '../lib/classe';
  import { monDuel, elimine, nomTour, fmtQuand, type Tournoi } from '../lib/tournoi';
  (async () => {
    const session = await requireSession(); if (!session) return;
    const sb = getSupabase();
    const p = await getProfile(session.user.id);
    document.getElementById('hello')!.textContent = p?.prenom ? `Bonjour ${p.prenom}` : 'Mon espace';
    if ((p as any)?.poste) document.getElementById('hello')!.insertAdjacentHTML('beforeend', ` <span class="poste-badge" style="font-size:1rem;vertical-align:middle;letter-spacing:0;background:var(--rouge);color:#fff;">${String((p as any).poste).replace(/[<>&]/g, '')}</span>`);
    if (p && ['bureau', 'admin'].includes(p.role)) document.getElementById('bureauLink')!.classList.remove('hidden');
    if (new URLSearchParams(location.search).get('bienvenue')) { const w = document.getElementById('welcome')!; w.classList.remove('hidden'); w.innerHTML = '<div class="alert alert-ok">Bienvenue ! Ton compte est activé : tu es maintenant membre de l\'instance. Réponds aux prochaines séances ci-dessous.</div>'; }
    document.getElementById('logout')!.addEventListener('click', signOut);

    // Profil
    // Guide d'installation : envoyé une fois, à la première connexion d'un nouveau membre
    // Signature du membre (affichée sur le certificat)
    const sigImg = document.getElementById('sigImg') as HTMLImageElement, sigAp = document.getElementById('sigApercu')!, sigBtn = document.getElementById('sigEdit')!;
    let aSigne = false;
    const certCard = document.getElementById('certCard') as HTMLDetailsElement;
    const majSig = (img: string | null, replier = false) => {
      aSigne = !!img;
      const ch = document.getElementById('chipCert')!; ch.textContent = img ? 'Certificat signé' : 'Certificat à signer'; ch.className = img ? 'ok' : 'todo';
      if (img) { sigImg.src = img; sigAp.classList.remove('hidden'); sigBtn.textContent = 'Refaire ma signature'; document.getElementById('certEtat')!.textContent = 'Signé · télécharger ou refaire la signature'; if (replier) certCard.open = false; }
    };
    const { data: sigRow } = await sb.from('signatures').select('image').eq('user_id', session.user.id).maybeSingle();
    majSig(sigRow?.image || null, true);
    const signer = async (titre: string, texte: string, annuler: string | null = 'Annuler') => {
      const img = await demanderSignature({ titre, texte, annuler });
      if (!img) return false;
      const { error } = await sb.from('signatures').upsert({ user_id: session.user.id, image: img, signed_at: new Date().toISOString() });
      if (error) { alert("La signature n'a pas pu être enregistrée. Réessaie."); return false; }
      majSig(img); return true;
    };
    sigBtn.addEventListener('click', () => signer('Ta signature', 'Elle apparaîtra sur ton certificat de membre, à côté de celle de la présidence.'));

    // Nouveau membre : signature du certificat, puis email de bienvenue (guide d'installation + certificat en pièce jointe)
    if (p && !(p as any).guide_envoye_at) {
      if (!aSigne) await signer(`Bienvenue ${p.prenom || ''} !`.replace(' !', ' !'), "Signe ta carte de membre : ta signature figurera sur ton certificat de membre, que nous t'envoyons par email avec le guide pour installer l'application.", null);
      postJSON('/api/bienvenue', {}, session.access_token).catch(() => {});
    }

    // Notifications push
    const nOn = document.getElementById('notifOn')!, nOff = document.getElementById('notifOff')!, nInst = document.getElementById('notifInstall')!;
    const nTxt = document.getElementById('notifTxt')!, nMsg = document.getElementById('notifMsg')!;
    const majNotif = async () => {
      const e = await etatPush();
      const cn = document.getElementById('chipNotif')!; cn.textContent = e === 'actif' ? 'Notifications activées' : 'Notifications désactivées'; cn.className = e === 'actif' ? 'ok' : 'todo';
      [nOn, nOff, nInst].forEach((b) => b.classList.add('hidden'));
      if (e === 'actif') { nTxt.textContent = 'Activées sur cet appareil. Tu recevras les nouvelles séances, le rappel la veille et les votes.'; nOff.classList.remove('hidden'); }
      else if (e === 'inactif') { nTxt.textContent = 'Nouvelles séances, rappel la veille, votes : reçois une alerte comme un SMS.'; nOn.classList.remove('hidden'); if (!estApp()) nInst.classList.remove('hidden'); }
      else if (e === 'ios-installer') { nTxt.textContent = "Sur iPhone, les notifications ne marchent que dans l'application : ajoute d'abord le site à ton écran d'accueil."; nInst.classList.remove('hidden'); }
      else if (e === 'bloque') nTxt.textContent = "Les notifications sont bloquées pour ce site. Autorise-les dans les réglages de ton téléphone ou de ton navigateur, puis recharge la page.";
      else { nTxt.textContent = "Ce navigateur ne gère pas les notifications. Installe l'application depuis Safari (iPhone) ou Chrome (Android)."; nInst.classList.remove('hidden'); }
    };
    majNotif().then(async () => {
      // Application installée : on propose tout de suite d'activer les notifications (un toucher est exigé par le téléphone)
      if (!estApp() || (await etatPush()) !== 'inactif' || sessionStorage.getItem('jpv_notif_vu')) return;
      sessionStorage.setItem('jpv_notif_vu', '1');
      const d = document.createElement('dialog'); d.className = 'sig-dialog';
      d.innerHTML = `<div class="sig-box"><h2 class="sig-t">Ne rate aucune séance</h2><p class="sig-p">Active les notifications : nouvelle séance, rappel la veille, votes et messages du bureau arrivent directement sur ton téléphone.</p>
        <button class="btn btn-primary sig-big" type="button" id="dnOui">Activer les notifications</button><button class="btn btn-outline btn-sm" type="button" id="dnNon">Plus tard</button><div id="dnMsg" class="small" aria-live="polite"></div></div>`;
      document.body.appendChild(d); d.showModal();
      d.querySelector('#dnNon')!.addEventListener('click', () => { d.close(); d.remove(); });
      d.querySelector('#dnOui')!.addEventListener('click', async () => {
        try { await activerPush(sb); d.close(); d.remove(); nMsg.innerHTML = '<div class="alert alert-ok">Notifications activées.</div>'; }
        catch (e: any) { d.querySelector('#dnMsg')!.textContent = e?.message === 'bloque' ? 'Les notifications sont bloquées : autorise-les dans les réglages du téléphone.' : 'Activation impossible pour le moment. Tu pourras réessayer depuis ton espace.'; }
        majNotif();
      });
    });
    nOn.addEventListener('click', async () => {
      nMsg.innerHTML = '';
      try { await activerPush(sb); nMsg.innerHTML = '<div class="alert alert-ok">Notifications activées.</div>'; }
      catch (e: any) { nMsg.innerHTML = `<div class="alert alert-err">${e?.message === 'bloque' ? 'Tu as bloqué les notifications : autorise-les dans les réglages, puis réessaie.' : e?.message === 'refuse' ? 'Notifications non autorisées.' : "L'activation a échoué. Réessaie dans un instant."}</div>`; }
      majNotif();
    });
    nOff.addEventListener('click', async () => { await desactiverPush(sb); nMsg.innerHTML = '<div class="alert alert-ok">Notifications désactivées sur cet appareil.</div>'; majNotif(); });

    // Certificat de membre
    document.getElementById('certif')!.addEventListener('click', async (ev) => {
      const b = ev.currentTarget as HTMLButtonElement; b.disabled = true; b.textContent = 'Préparation du PDF…';
      if (!aSigne && !(await signer('Signe ton certificat', 'Ta signature figurera sur ton certificat de membre, à côté de celle de la présidence.'))) { b.disabled = false; b.textContent = 'Télécharger mon certificat (PDF)'; return; }
      try { await telechargerCertificat(session.access_token); document.getElementById('certifMsg')!.innerHTML = ''; }
      catch { document.getElementById('certifMsg')!.innerHTML = '<div class="alert alert-err">Le certificat n\'a pas pu être généré. Réessaie.</div>'; }
      b.disabled = false; b.textContent = 'Télécharger mon certificat (PDF)';
    });

    const f = document.getElementById('profileForm') as HTMLFormElement;
    const editBtn = document.getElementById('editInfos') as HTMLButtonElement;
    const toggleInfos = (open: boolean) => { f.classList.toggle('hidden', !open); editBtn.classList.toggle('hidden', open); editBtn.setAttribute('aria-expanded', String(open)); if (open) (f.elements.namedItem('prenom') as HTMLInputElement).focus(); else document.getElementById('pmsg')!.innerHTML = ''; };
    editBtn.addEventListener('click', () => toggleInfos(true));
    document.getElementById('cancelInfos')!.addEventListener('click', () => toggleInfos(false));
    (f.elements.namedItem('prenom') as HTMLInputElement).value = p?.prenom || '';
    (f.elements.namedItem('nom') as HTMLInputElement).value = p?.nom || '';
    remplirClasse(f, (p as any)?.niveau, (p as any)?.classe_num);
    sb.rpc('mes_coordonnees').then(({ data }) => { (f.elements.namedItem('telephone') as HTMLInputElement).value = data?.telephone || ''; });
    (document.getElementById('email') as HTMLInputElement).value = session.user.email || '';
    f.addEventListener('submit', async (e) => {
      e.preventDefault(); const fd = new FormData(f);
      if (!f.checkValidity()) { f.reportValidity(); return; }
      const tel = String(fd.get('telephone') || '').trim() || null;
      const cl = lireClasse(fd);
      const { error } = await sb.from('profiles').update({ prenom: fd.get('prenom'), nom: fd.get('nom'), classe: cl.classe || null, niveau: cl.niveau || null, classe_num: cl.classe_num, telephone: tel }).eq('id', session.user.id);
      if (!error) await sb.from('adhesions').update({ prenom: fd.get('prenom'), nom: fd.get('nom'), classe: cl.classe || '?', telephone: tel }).eq('user_id', session.user.id);
      if (error) { document.getElementById('pmsg')!.innerHTML = `<div class="alert alert-err">${error.message}</div>`; return; }
      toggleInfos(false); editBtn.insertAdjacentHTML('afterend', '<span class="small muted" id="savedNote" style="margin-left:10px;">Informations enregistrées.</span>'); setTimeout(() => document.getElementById('savedNote')?.remove(), 4000);
    });

    // Cases Motions / Vote / Profil : un aperçu en direct
    sb.rpc('motions_liste').then(({ data }) => { const n = ((data as any[]) || []).filter((x) => x.statut === 'proposee' && !x.mon_vote).length; if (n) document.getElementById('tMotions')!.textContent = `${n} motion${n > 1 ? 's' : ''} à découvrir et soutenir`; });
    // Vote du meilleur orateur (présents à une séance, 3 jours)
    const moVote = document.getElementById('moVote')!;
    const finFmt = (d: string) => new Date(d).toLocaleString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' });
    const rendreVote = (v: any) => {
      moVote.innerHTML = `<p class="mo-k">Meilleur orateur</p><h3>${esc(v.titre)}</h3>
        <p class="small muted">${v.mon_vote ? 'Ton vote est enregistré. Tu peux le changer' : 'Qui t\'a le plus convaincu ? Vote anonyme, réservé aux présents. Ouvert'} jusqu'au ${esc(finFmt(v.fin))}.</p>
        <div class="mo-liste" role="group" aria-label="Choisir le meilleur orateur">${v.candidats.map((c: any) => `<button type="button" class="mo-opt${c.id === v.mon_vote ? ' choisi' : ''}" data-id="${c.id}" aria-pressed="${c.id === v.mon_vote}"><span><strong>${esc(c.prenom)} ${esc(c.nom)}</strong> <span class="small muted">${esc(c.classe || '')}${c.camp ? ` · ${esc(c.camp)}` : ''}</span></span><span class="small">${c.id === v.mon_vote ? 'Mon vote' : 'Voter'}</span></button>`).join('')}</div>
        <div id="moMsg" aria-live="polite"></div>`;
      moVote.querySelectorAll<HTMLButtonElement>('.mo-opt').forEach((b) => b.addEventListener('click', async () => {
        moVote.querySelectorAll<HTMLButtonElement>('.mo-opt').forEach((x) => (x.disabled = true));
        const { error } = await sb.rpc('voter_meilleur_orateur', { p_event: v.event, p_orateur: b.dataset.id });
        if (error) {
          const M: Record<string, string> = { vote_clos: 'Le vote est clos.', pas_present: 'Seuls les présents à la séance peuvent voter.', orateur_absent: "Cette personne n'était pas présente." };
          document.getElementById('moMsg')!.innerHTML = `<div class="alert alert-err">${M[Object.keys(M).find((k) => error.message.includes(k)) || ''] || 'Le vote n\'a pas pu être enregistré.'}</div>`;
          moVote.querySelectorAll<HTMLButtonElement>('.mo-opt').forEach((x) => (x.disabled = false));
          return;
        }
        v.mon_vote = b.dataset.id; rendreVote(v);
        document.getElementById('moMsg')!.innerHTML = '<div class="alert alert-ok">Vote enregistré.</div>';
      }));
    };
    sb.rpc('votes_orateur_ouverts').then(({ data }) => {
      const v = ((data as any[]) || []).find((x) => x.candidats.length);
      if (!v) return;
      rendreVote(v); moVote.classList.remove('hidden');
    });
    // Tournoi d'éloquence : inscriptions ouvertes ou prochain duel
    sb.rpc('tournois_liste').then(({ data }) => {
      const ts = (data as Tournoi[]) || [], moi = session.user.id, el = document.getElementById('tnCard')!;
      const enCours = ts.find((t) => t.statut === 'en_cours' && t.matchs.some((m) => m.a === moi || m.b === moi));
      const ouvert = ts.find((t) => t.statut === 'inscriptions' && (!t.fin_inscriptions || new Date(t.fin_inscriptions) > new Date()));
      if (enCours) {
        const m = monDuel(enCours, moi); const nb = Math.max(...enCours.matchs.map((x) => x.tour));
        if (!m && !elimine(enCours, moi)) return;
        el.innerHTML = `<p class="mo-k">Tournoi d'éloquence</p><h3>${m ? `${esc(nomTour(m.tour, nb))} : contre ${esc((m.a === moi ? m.b_nom : m.a_nom) || '?')}` : 'Ton parcours s\'arrête ici'}</h3>
          ${m ? `<p class="small muted">${m.sujet ? `Sujet : « ${esc(m.sujet)} »` : 'Le sujet sera annoncé par le bureau.'}${m.quand ? `<br>${esc(fmtQuand(m.quand))}${m.lieu ? ` · ${esc(m.lieu)}` : ''}` : ''}</p>` : '<p class="small muted">Merci d\'avoir défendu tes idées. Suis la suite du tournoi.</p>'}
          <a class="btn btn-outline btn-sm" href="${u('/tournoi')}">Voir le tableau</a>`;
      } else if (ouvert) {
        el.innerHTML = `<p class="mo-k">Tournoi d'éloquence</p><h3>${esc(ouvert.nom)}</h3><p class="small muted">${ouvert.moi_inscrit ? 'Tu es inscrit. Tu recevras ton premier duel après le tirage au sort.' : `Inscriptions ouvertes${ouvert.fin_inscriptions ? ` jusqu'au ${new Date(ouvert.fin_inscriptions).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long' })}` : ''} · ${ouvert.inscrits} inscrit${ouvert.inscrits > 1 ? 's' : ''}.`}</p>
          <a class="btn ${ouvert.moi_inscrit ? 'btn-outline' : 'btn-primary'} btn-sm" href="${u('/tournoi')}">${ouvert.moi_inscrit ? 'Voir le tournoi' : 'Je m\'inscris'}</a>`;
      } else return;
      el.classList.remove('hidden');
    });
    sb.rpc('sondages_liste').then(({ data }) => {
      const n = ((data as any[]) || []).filter((s) => s.ouvert && !s.mon_choix).length;
      if (n) document.getElementById('tSondages')!.textContent = `${n} sondage${n > 1 ? 's attendent' : ' attend'} ta réponse`;
    });
    sb.rpc('sorties_liste').then(({ data }) => {
      const ss = ((data as any[]) || []).filter((s) => !s.annule && new Date(s.quand) > new Date());
      const moi = ss.find((s) => s.mon_statut === 'inscrit');
      const t = document.getElementById('tSorties')!;
      if (moi) t.textContent = `Inscrit·e : ${moi.titre}, le ${new Date(moi.quand).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long' })}${moi.autorisation && !moi.mon_autorisation ? ' (autorisation à rapporter)' : ''}`;
      else if (ss.length) t.textContent = `${ss.length} sortie${ss.length > 1 ? 's' : ''} à venir : ${ss[0].titre}`;
    });
    sb.rpc('derniers_meilleurs_orateurs', { p_limite: 1 }).then(({ data }) => {
      const d = ((data as any[]) || [])[0];
      if (!d?.laureats?.length || Date.now() - new Date(d.date).getTime() > 21 * 86400000) return;
      const el = document.getElementById('moLaureat')!;
      const moi = d.laureats.some((l: any) => l.id === session.user.id);
      el.innerHTML = `<p class="mo-k">Meilleur orateur · ${esc(d.titre)}</p><h3>${moi ? 'Bravo, c\'est toi !' : d.laureats.map((l: any) => `${esc(l.prenom)} ${esc(l.nom)}`).join(' et ')}</h3>
        <p class="small muted">${moi ? 'Les présents t\'ont élu meilleur orateur de la séance. Le titre est ajouté à ton profil.' : `Élu${d.laureats.length > 1 ? 's' : ''} par les présents avec ${d.laureats[0].voix} voix.`}</p>
        <a class="btn btn-outline btn-sm" href="${u('/profil')}${moi ? '' : `?u=${d.laureats[0].id}`}">Voir le profil</a>`;
      el.classList.remove('hidden');
    });

    sb.rpc('elections_liste').then(({ data }) => {
      const els = ((data as any[]) || []).filter((e) => e.statut === 'ouverte' || e.statut === 'programmee');
      if (!els.length) return; // aucun vote en cours : pas de case Vote
      const tuile = document.getElementById('tuileVote')!, tVote = document.getElementById('tVote')!;
      tuile.classList.remove('hidden');
      const aVoter = els.find((e) => e.statut === 'ouverte' && !e.a_vote && e.peut_voter);
      const prog = els.find((e) => e.statut === 'programmee');
      const fin = (d: string | null) => d ? new Date(d).toLocaleString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' }) : '';
      if (aVoter) {
        const a = document.getElementById('voteAlerte')!;
        a.innerHTML = `<span class="va-k">Vote ouvert</span><strong>${esc(aVoter.titre)}</strong>${aVoter.fermeture ? `<span>Tu peux voter jusqu'au ${esc(fin(aVoter.fermeture))}.</span>` : ''}<span class="va-go">Je vote</span>`;
        a.classList.remove('hidden');
        tVote.textContent = `Vote ouvert : ${aVoter.titre}`; tuile.classList.add('tuile-chaud');
      } else if (els.some((e) => e.statut === 'ouverte' && e.a_vote)) tVote.textContent = `Tu as voté : ${els.find((e) => e.a_vote).titre}`;
      else if (prog) tVote.textContent = `Vote à venir : ${prog.titre}, ouverture le ${fin(prog.ouverture)}`;
    });
    sb.rpc('profil_orateur').then(({ data }) => { if (data?.seances) document.getElementById('tProfil')!.textContent = `${data.seances} séance${data.seances > 1 ? 's' : ''}${Object.keys(data.roles || {}).length ? ` · ${Object.values(data.roles).reduce((a: number, n: any) => a + Number(n), 0)} prise(s) de parole` : ''}`; });

    // Annonces de séances
    const ann = document.getElementById('annonces') as HTMLInputElement;
    sb.rpc('mes_annonces').then(({ data }) => { ann.checked = data !== false; });
    ann.addEventListener('change', async () => {
      const { error } = await sb.rpc('mes_annonces', { p_actif: ann.checked });
      document.getElementById('amsg')!.textContent = error ? "Le réglage n'a pas pu être enregistré." : ann.checked ? 'Tu recevras les annonces des nouvelles séances.' : "Tu ne recevras plus les annonces de séances. Les emails liés à tes inscriptions restent envoyés.";
    });

    // Candidature
    const { data: cands } = await sb.from('candidatures').select('type, poste, statut, created_at, decided_at, note_bureau').eq('user_id', session.user.id).order('created_at', { ascending: false });
    const cEl = document.getElementById('cand')!;
    const SEMAINE = 7 * 24 * 3600 * 1000;
    const visibles = (cands || []).filter((c: any) => !['acceptee', 'refusee'].includes(c.statut) || Date.now() - new Date(c.decided_at || c.created_at).getTime() < SEMAINE);
    const labels: Record<string, string> = { nouvelle: 'Reçue, en attente', en_cours: 'En cours d’examen', acceptee: 'Acceptée 🎉', refusee: 'Non retenue' };
    cEl.innerHTML = visibles.length
      ? visibles.map((c) => `<p><span class="pill">${c.type === 'bureau' ? `bureau${c.poste ? ' — ' + c.poste : ''}` : c.type}</span> déposée le ${new Date(c.created_at).toLocaleDateString('fr-FR')} — <strong>${labels[c.statut] || c.statut}</strong>${c.note_bureau ? `<br><span class="small muted">Message du bureau : ${esc(c.note_bureau)}</span>` : ''}</p>`).join('')
      : '<p class="muted">Aucune candidature en cours.</p><a class="btn btn-primary btn-sm" href="/candidature">Candidater</a>';

    // Prochains événements : je viens / je ne viens pas
    const evBox = document.getElementById('events')!;
    const evs = await fetchUpcoming();
    if (!evs.length) evBox.innerHTML = '<p class="muted">Aucun événement programmé pour l\'instant : nos séances reprennent très bientôt.</p>';
    else {
      const { data: mine } = await sb.from('event_signups').select('event_key, reponse, camp, jeton').eq('user_id', session.user.id);
      const rep = new Map((mine || []).map((r) => [r.event_key, r.reponse]));
      const camp = new Map((mine || []).map((r) => [r.event_key, r.camp]));
      const jet = new Map((mine || []).map((r) => [r.event_key, r.jeton]));
      const paint = () => {
        evBox.innerHTML = evs.map((e) => `<div class="event"><div class="event-date"><b>${fmt.day(e.starts_at)}</b><span>${esc(fmt.monShort(e.starts_at))}</span></div><div><span class="pill">${esc(e.type)}</span><h3>${esc(e.title)}</h3><div class="meta">${esc(fmt.long(e.starts_at))}, ${when(e)} · ${esc(e.location)}</div>
          <div class="flex mt-1" style="gap:8px;"><button class="btn btn-sm ${rep.get(e.id) === 'oui' ? 'btn-primary' : 'btn-outline'} rsvp" data-id="${e.id}" data-r="oui" type="button">${rep.get(e.id) === 'oui' ? '✓ ' : ''}Je viens</button><button class="btn btn-sm ${rep.get(e.id) === 'non' ? 'btn-primary' : 'btn-outline'} rsvp" data-id="${e.id}" data-r="non" type="button">${rep.get(e.id) === 'non' ? '✓ ' : ''}Je ne viens pas</button></div>${rep.get(e.id) === 'oui' && camp.get(e.id) ? `<p class="mt-1" style="margin-bottom:0;">Ton camp, tiré au sort : <strong style="color:var(--rouge);">${esc(camp.get(e.id))}</strong></p>${jet.get(e.id) ? `<a class="btn btn-primary btn-sm mt-1" href="${u('/salle')}?t=${jet.get(e.id)}">Salle de préparation de mon camp</a>` : ''}` : ''}</div></div>`).join('');
        evBox.querySelectorAll<HTMLButtonElement>('.rsvp').forEach((b) => b.addEventListener('click', async () => {
          const id = b.dataset.id!, r = b.dataset.r as 'oui' | 'non';
          b.disabled = true;
          const { error } = rep.has(id)
            ? await sb.from('event_signups').update({ reponse: r }).eq('event_key', id).eq('user_id', session.user.id)
            : await sb.from('event_signups').insert({ event_key: id, reponse: r, user_id: session.user.id, prenom: p?.prenom || '?', nom: p?.nom || '?', classe: p?.classe || '?', email: session.user.email });
          if (error) { b.disabled = false; alert(/camps_complets/.test(error.message) ? 'Tous les camps sont complets pour cet événement.' : /evenement_annule/.test(error.message) ? 'Cet événement a été annulé.' : error.code === '23505' ? 'Ton adresse a déjà répondu à cet événement sans être connectée.' : "Réponse impossible : complète d'abord ton prénom, ton nom et ta classe."); return; }
          const { data: row } = await sb.from('event_signups').select('camp, jeton').eq('event_key', id).eq('user_id', session.user.id).maybeSingle();
          rep.set(id, r); camp.set(id, row?.camp ?? null); jet.set(id, row?.jeton ?? null); paint();
          if (r === 'oui' && row?.jeton) postJSON('/api/salle-lien', { jeton: row.jeton }).catch(() => {});
        }));
      };
      paint();
    }

    // Suppression
    document.getElementById('delAccount')!.addEventListener('click', async () => {
      if (!confirm('Supprimer définitivement ton compte et toutes tes données ?')) return;
      const r = await fetch(api('/api/account-delete'), { method: 'POST', headers: { Authorization: `Bearer ${session.access_token}` } });
      if (r.ok) { await sb.auth.signOut(); location.href = u('/?compte=supprime'); } else alert('Erreur lors de la suppression.');
    });
  })();
</script>
