---
import Base from '../../layouts/Base.astro';
---
<Base title="Se désinscrire" noindex>
  <div class="auth-wrap"><div class="card auth-card">
    <span class="eyebrow">La lettre du Parlement</span>
    <h1>Se désinscrire</h1>
    <p class="muted small">Le lien en bas de chaque email fait la même chose en un clic.</p>
    <form class="form" id="unsubForm" novalidate>
      <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" required /></div>
      <div id="msg"></div>
      <button class="btn btn-outline" type="submit">Me désinscrire</button>
    </form>
  </div></div>
</Base>
<script>
  import { postJSON } from '../../lib/newsletter';
  const form = document.getElementById('unsubForm') as HTMLFormElement; const msg = document.getElementById('msg')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault(); if (!form.checkValidity()) { form.reportValidity(); return; }
    const r = await postJSON<{ message: string }>('/api/newsletter-unsubscribe', { email: String(new FormData(form).get('email')) });
    msg.innerHTML = r.ok ? `<div class="alert alert-ok">${r.data.message}</div>` : `<div class="alert alert-err">${r.error}</div>`;
  });
</script>
