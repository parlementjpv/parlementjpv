  .bu-tile { position: relative; display: grid; align-content: start; gap: 6px; text-align: left; min-height: 150px; padding: 22px 22px 18px; border: 3px solid var(--nuit); border-left-width: 10px; background: var(--blanc); color: var(--nuit); font: inherit; cursor: pointer; transition: transform 0.15s ease, background 0.15s ease; }
