  .bu-bar { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; margin-bottom: 22px; padding-bottom: 14px; border-bottom: var(--rule); }
  .bu-bar h2 { margin: 0; font-size: clamp(1.6rem, 3vw, 2.2rem); }
  @media (prefers-reduced-motion: reduce) { .bu-tile { transition: none; } .bu-tile:hover { transform: none; } }

  .ap-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 2px solid var(--pierre-fonce); flex-wrap: wrap; }
  .ap-btns { display: flex; gap: 0; }
  .ap-b { border: 2px solid var(--nuit); background: transparent; color: var(--nuit); font: inherit; font-weight: 700; font-size: 0.85rem; padding: 6px 12px; cursor: pointer; margin-left: -2px; }
  .ap-b.on.ap-present { background: var(--ok, #1f7a4d); border-color: var(--ok, #1f7a4d); color: #fff; }
  .ap-b.on.ap-absent { background: var(--rouge); border-color: var(--rouge); color: #fff; }
  .ap-b.on.ap-excuse { background: var(--nuit); color: #fff; }
  .el-cands { display: grid; gap: 6px; margin: 8px 0; }
  .el-c { display: flex; justify-content: space-between; align-items: center; gap: 10px; background: var(--pierre); padding: 8px 12px; }
  .el-res { white-space: nowrap; }
  .lnk { background: none; border: 0; padding: 0; font: inherit; font-size: 0.85rem; font-weight: 700; color: var(--nuit); text-decoration: underline; text-decoration-color: var(--rouge); text-underline-offset: 3px; cursor: pointer; }
  .tk-board { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .tk-col h4 { font-size: 0.95rem; border-bottom: 3px solid var(--nuit); padding-bottom: 4px; }
  .tk { border: 2px solid var(--pierre-fonce); padding: 8px 10px; margin-bottom: 8px; background: var(--blanc); }
  .tk.tk-moi { border-color: var(--rouge); }
  .tk p { margin: 4px 0; white-space: pre-wrap; }
  .tk-late { color: var(--rouge); font-weight: 700; }
  .tk-act { margin-top: 6px; display: flex; flex-wrap: wrap; gap: 8px; }
  .chat { max-height: 320px; overflow-y: auto; display: grid; gap: 8px; padding: 4px 0 10px; }
  .msg { max-width: 85%; background: var(--pierre); padding: 8px 12px; }
  .msg.mien { justify-self: end; background: var(--nuit); color: #fff; }
  .msg b { display: block; font-size: 0.8rem; } .msg p { margin: 0; white-space: pre-wrap; } .msg time { display: block; font-size: 0.72rem; opacity: 0.65; }
  .chat-form { display: grid; grid-template-columns: 1fr auto; }
  .chat-form input { padding: 10px 12px; border: 3px solid var(--nuit); border-right: 0; font: inherit; background: var(--blanc); color: var(--nuit); }
  .nt-list { display: grid; gap: 6px; }
  .nt-item { text-align: left; border: 2px solid var(--pierre-fonce); background: transparent; color: var(--nuit); font: inherit; padding: 8px 10px; cursor: pointer; display: grid; }
  .nt-item.on { border-color: var(--nuit); background: var(--pierre); }
  .nt-titre { width: 100%; font: inherit; font-weight: 800; font-size: 1.1rem; padding: 8px 10px; border: 3px solid var(--nuit); margin-bottom: 8px; background: var(--blanc); color: var(--nuit); }
  .nt-ed { width: 100%; min-height: 260px; font: inherit; padding: 10px; border: 3px solid var(--nuit); background: var(--blanc); color: var(--nuit); }
  @media (max-width: 760px) { .tk-board { grid-template-columns: 1fr; } }
.table select, .table input { font: inherit; font-size: 0.85rem; padding: 4px 6px; border-radius: 6px; border: 1px solid var(--pierre-fonce); } .motiv { max-width: 360px; white-space: pre-wrap; font-size: 0.85rem; }  .ev-admin { grid-template-columns: minmax(300px, 1fr) minmax(320px, 1.2fr); align-items: start; }
  @media (max-width: 900px) { .ev-admin { grid-template-columns: 1fr; } }
  .ev-item { padding: 16px 0; border-bottom: 2px solid var(--pierre-fonce); }
  .ev-item.past { opacity: 0.6; }
  .ev-stats { margin: 8px 0 4px; }
  .ev-stats b { font-size: 1.3rem; color: var(--rouge); }
  .ev-item summary { cursor: pointer; font-weight: 700; font-size: 0.9rem; }
  .ev-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; font-size: 0.88rem; margin-top: 8px; }
  .ev-cols h4 { margin-bottom: 4px; }
  .decide { display: grid; gap: 6px; min-width: 110px; }
  .table textarea { width: 100%; min-width: 180px; font: inherit; font-size: 0.85rem; padding: 6px; border: 2px solid var(--pierre-fonce); }
  #memTable tr.banned td { opacity: 0.55; }
  .ecrire { grid-template-columns: minmax(300px, 1fr) minmax(320px, 1.1fr); align-items: start; }
  @media (max-width: 900px) { .ecrire { grid-template-columns: 1fr; } }
  .mm-list { max-height: 460px; overflow-y: auto; border-top: 2px solid var(--pierre-fonce); }
  .mm-row { display: flex; gap: 10px; align-items: flex-start; padding: 8px 2px; border-bottom: 1px solid var(--pierre-fonce); cursor: pointer; }
  .mm-row input { margin-top: 4px; accent-color: var(--rouge); width: 18px; height: 18px; flex: none; }
  .mm-tag { cursor: pointer; border: 0; font: inherit; font-size: 0.8rem; } .mm-tag.active { background: var(--nuit); color: #fff; }
  .mm-hist { padding: 6px 0; border-bottom: 1px solid var(--pierre-fonce); } .mm-hist summary { cursor: pointer; }
  .del-user { background: var(--rouge); border-color: var(--rouge); }
  .camps-field { border: 2px solid var(--pierre-fonce); padding: 12px 14px 4px; margin: 0; }
  .camps-field legend { font-weight: 800; padding: 0 6px; }
  .camps-field legend small { font-weight: 400; color: var(--gris); }
  .camps-field:has(#ev-nocamp:checked) :is(.camps-list, #campAdd, .field) { opacity: 0.35; pointer-events: none; }
  .camps-list { display: grid; gap: 8px; margin-bottom: 10px; }
  .camp-row { display: grid; grid-template-columns: 70px 1fr 40px; gap: 8px; align-items: center; }
  .camp-n { font-weight: 700; font-size: 0.9rem; }
  .camp-row input { padding: 9px 11px; border: 3px solid var(--nuit); font: inherit; background: var(--blanc); color: var(--nuit); }
  .camp-del { height: 40px; border: 2px solid var(--nuit); background: transparent; color: var(--nuit); font-size: 1.3rem; cursor: pointer; }
  .camp-del:disabled { opacity: 0.25; cursor: default; }
  #campAdd { margin-bottom: 12px; }
  .ev-annule { display: inline-block; margin-top: 4px; background: var(--rouge); color: #fff; font-weight: 800; font-size: 0.85rem; padding: 2px 8px; }
  .ev-campstats { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 6px; }
