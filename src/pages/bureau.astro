  .ar-tools { display: flex; flex-wrap: wrap; gap: 0; margin-bottom: -3px; }
  .ar-tools button { border: 3px solid var(--nuit); background: var(--pierre); color: var(--nuit); font: inherit; font-size: 0.82rem; font-weight: 700; padding: 5px 10px; cursor: pointer; margin-right: -3px; }
  .ar-tools button:hover { background: var(--blanc); }
