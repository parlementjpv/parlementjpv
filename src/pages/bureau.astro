<script>
  import { getSupabase } from '../lib/supabase';
  import { requireSession, getProfile } from '../lib/auth';
  import { postJSON } from '../lib/newsletter';
  import { u } from '../lib/url';
  import { mdToHtml, mdToText } from '../lib/markdown';
  const esc = (s: any) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
  const d = (s: string) => new Date(s).toLocaleDateString('fr-FR');
  import { initBureauPlus } from '../lib/bureau-plus';
  import postesData from '../data/postes.json';
  const POSTES = (postesData as { titre: string }[]).map((p) => p.titre);
  (async () => {
    const session = await requireSession(); if (!session) return;
    const sb = getSupabase();
    const me = await getProfile(session.user.id);
    if (!me || !['bureau', 'admin'].includes(me.role)) { document.getElementById('denied')!.style.display = ''; return; }
    document.getElementById('app')!.style.display = '';
    const isAdmin = me.role === 'admin';
    initBureauPlus(sb, session, me as any).catch((e) => console.error(e));
    if (isAdmin) {
      document.getElementById('buAdminGroup')!.classList.remove('hidden');
      const { data: jn } = await sb.from('journal').select('*').order('at', { ascending: false }).limit(1000);
      const lignes = (jn || []) as any[];
      const qui = document.getElementById('jnQui') as HTMLSelectElement;
      [...new Set(lignes.map((l) => l.acteur_nom))].sort().forEach((n) => qui.insertAdjacentHTML('beforeend', `<option>${esc(n)}</option>`));
      const paintJn = () => {
        const c = (document.getElementById('jnCat') as HTMLSelectElement).value, p = qui.value, q = (document.getElementById('jnQ') as HTMLInputElement).value.trim().toLowerCase();
        const f = lignes.filter((l) => (!c || l.categorie === c) && (!p || l.acteur_nom === p) && (!q || `${l.acteur_nom} ${l.resume}`.toLowerCase().includes(q)));
        document.getElementById('jnList')!.innerHTML = f.map((l) => `<div class="jn-row"><span class="jn-quand">${new Date(l.at).toLocaleString('fr-FR', { day: 'numeric', month: 'short', year: '2-digit', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Paris' })}</span><span class="jn-qui">${esc(l.acteur_nom)}</span><span><span class="jn-cat">${esc(l.categorie)}</span>${esc(l.resume)}</span></div>`).join('') || '<p class="muted">Aucune action enregistrée pour l\'instant.</p>';
      };
      ['jnCat', 'jnQui', 'jnQ'].forEach((id) => document.getElementById(id)!.addEventListener('input', paintJn));
      paintJn();
    }

    // Tabs
    // Menu du bureau : grandes cases ; chaque case ouvre sa section, « ← Menu du bureau » revient
    const menu = document.getElementById('buMenu')!, bar = document.getElementById('buBar')!;
    const ouvrir = (k: string | null, push = true) => {
      const tile = k ? document.querySelector<HTMLButtonElement>(`.bu-tile[data-tab="${k}"]`) : null;
      document.querySelectorAll('.panel').forEach((p) => p.classList.add('hidden'));
      if (!tile) { menu.classList.remove('hidden'); bar.classList.add('hidden'); if (push) history.pushState(null, '', location.pathname); return; }
      menu.classList.add('hidden'); bar.classList.remove('hidden');
      document.getElementById('buTitle')!.textContent = tile.querySelector('.bu-tile-t')!.textContent;
      document.getElementById(`tab-${k}`)!.classList.remove('hidden');
      if (push) history.pushState(null, '', `#${k}`);
      window.scrollTo({ top: menu.parentElement!.offsetTop - 80 });
    };
    document.querySelectorAll<HTMLButtonElement>('.bu-tile').forEach((t) => t.addEventListener('click', () => ouvrir(t.dataset.tab!)));
    document.getElementById('buBack')!.addEventListener('click', () => ouvrir(null));
    window.addEventListener('popstate', () => ouvrir(location.hash.slice(1) || null, false));
    ouvrir(location.hash.slice(1) || null, false);

    // Stats
    const [{ data: st }, { count: nCand }, { count: nMem }, { count: nMsg }] = await Promise.all([
      sb.from('newsletter_stats').select('*').single(),
      sb.from('candidatures').select('*', { count: 'exact', head: true }).in('statut', ['nouvelle', 'en_cours']),
      sb.from('adhesions').select('*', { count: 'exact', head: true }),
      sb.from('contact_messages').select('*', { count: 'exact', head: true }).eq('traite', false),
    ]);
    document.getElementById('sAbo')!.textContent = String(st?.confirmes ?? 0);
    document.getElementById('sCand')!.textContent = String(nCand ?? 0);
    document.getElementById('sMembres')!.textContent = String(nMem ?? 0);
    document.getElementById('sMsg')!.textContent = String(nMsg ?? 0);
    document.querySelectorAll('.bu-count').forEach((c) => c.classList.toggle('zero', c.textContent === '0'));
    document.getElementById('subs')!.innerHTML = `<strong>${st?.confirmes ?? 0}</strong> confirmés · ${st?.en_attente ?? 0} en attente · ${st?.desinscrits ?? 0} désinscrits`;

    // Candidatures : à traiter / archives
    const STAT: Record<string, string> = { nouvelle: 'Nouvelle', en_cours: 'En cours', acceptee: 'Acceptée', refusee: 'Refusée' };
    const candMsg = document.getElementById('candMsg')!;
    const posteOf = (c: any) => c.type === 'bureau' ? `<strong>${esc(c.poste || 'Tout poste')}</strong>` : '<span class="pill">membre</span>';
    const motivOf = (c: any) => `${esc(c.motivation)}${c.experience ? `<br><em class="muted">Exp. : ${esc(c.experience)}</em>` : ''}${c.disponibilites ? `<br><span class="muted">Dispo : ${esc(c.disponibilites)}</span>` : ''}`;
    const who = (c: any) => `<strong>${esc(c.prenom)} ${esc(c.nom)}</strong><br><span class="muted">${esc(c.classe)}<br><a href="mailto:${esc(c.email)}">${esc(c.email)}</a>${c.profiles?.telephone ? `<br><a href="tel:${esc(c.profiles.telephone)}">${esc(c.profiles.telephone)}</a>` : ''}</span>`;
    async function decide(id: string, statut: string, note?: string) {
      const r = await postJSON<{ emailed: boolean; warning?: string }>('/api/candidature-decision', { id, statut, note }, session.access_token);
      if (!r.ok) { candMsg.innerHTML = `<div class="alert alert-err">${esc(r.error)}</div>`; return false; }
      candMsg.innerHTML = r.data.warning ? `<div class="alert alert-err">${esc(r.data.warning)}</div>` : r.data.emailed ? '<div class="alert alert-ok">Décision enregistrée et email envoyé au candidat. La candidature est dans les archives.</div>' : '';
      return true;
    }
    async function loadCands() {
      const { data: cands } = await sb.from('candidatures').select('*, profiles(telephone)').order('created_at', { ascending: false });
      const open = (cands || []).filter((c: any) => c.statut === 'nouvelle' || c.statut === 'en_cours');
      const done = (cands || []).filter((c: any) => c.statut === 'acceptee' || c.statut === 'refusee').sort((a: any, b: any) => (b.decided_at || b.created_at).localeCompare(a.decided_at || a.created_at));
      document.getElementById('sCand')!.textContent = String(open.length);
      const tb = document.querySelector('#candTable tbody')!;
      tb.innerHTML = open.map((c: any) => `<tr>
        <td>${d(c.created_at)}<br><span class="pill">${STAT[c.statut]}</span></td><td>${who(c)}</td><td>${posteOf(c)}</td><td class="motiv">${motivOf(c)}</td>
        <td><textarea class="note" data-id="${c.id}" rows="3" placeholder="ex. Rendez-vous mardi midi au CDI">${esc(c.note_bureau || '')}</textarea></td>
        <td><div class="decide"><button class="btn btn-primary btn-sm dec" data-id="${c.id}" data-s="acceptee" type="button">Accepter</button><button class="btn btn-outline btn-sm dec" data-id="${c.id}" data-s="refusee" type="button">Refuser</button>${c.statut === 'nouvelle' ? `<button class="btn btn-outline btn-sm dec" data-id="${c.id}" data-s="en_cours" type="button">En cours</button>` : ''}</div></td></tr>`).join('') || '<tr><td colspan="6" class="muted">Aucune candidature à traiter.</td></tr>';
      tb.querySelectorAll<HTMLButtonElement>('.dec').forEach((b) => b.addEventListener('click', async () => {
        const c: any = open.find((x: any) => x.id === b.dataset.id); const s0 = b.dataset.s!;
        const note = (tb.querySelector(`.note[data-id="${b.dataset.id}"]`) as HTMLTextAreaElement).value;
        if (s0 !== 'en_cours' && !confirm(`${s0 === 'acceptee' ? 'Accepter' : 'Refuser'} la candidature de ${c.prenom} ${c.nom} ?\nUn email automatique lui sera envoyé à ${c.email}${note.trim() ? ' avec ton message' : ''}.`)) return;
        b.disabled = true; if (await decide(b.dataset.id!, s0, note)) loadCands(); else b.disabled = false;
      }));
      tb.querySelectorAll<HTMLTextAreaElement>('.note').forEach((t) => t.addEventListener('change', async () => { await sb.from('candidatures').update({ note_bureau: t.value.trim() || null }).eq('id', t.dataset.id); }));
      const ab = document.querySelector('#archTable tbody')!;
      ab.innerHTML = done.map((c: any) => `<tr>
        <td><span class="pill ${c.statut === 'acceptee' ? 'pill-gold' : ''}">${STAT[c.statut]}</span><br><span class="small muted">${c.decided_at ? d(c.decided_at) : ''}</span></td>
        <td>${who(c)}</td><td>${posteOf(c)}</td><td class="motiv">${motivOf(c)}</td><td class="motiv">${esc(c.note_bureau || '—')}</td>
        <td><button class="btn btn-outline btn-sm reopen" data-id="${c.id}" type="button">Rouvrir</button></td></tr>`).join('') || '<tr><td colspan="6" class="muted">Aucune candidature archivée.</td></tr>';
      ab.querySelectorAll<HTMLButtonElement>('.reopen').forEach((b) => b.addEventListener('click', async () => { b.disabled = true; if (await decide(b.dataset.id!, 'en_cours')) loadCands(); }));
    }
    await loadCands();

    // Newsletter
    const f = document.getElementById('nlForm') as HTMLFormElement, nlMsg = document.getElementById('nlMsg')!, prev = document.getElementById('preview')!;
    const show = (t: string, k = 'err') => (nlMsg.innerHTML = `<div class="alert alert-${k}">${t}</div>`);
    const val = () => ({ subject: (f.elements.namedItem('subject') as HTMLInputElement).value.trim(), body: (f.elements.namedItem('body') as HTMLTextAreaElement).value, id: (f.elements.namedItem('id') as HTMLInputElement).value });
    const save = async () => {
      const v = val(); if (!v.subject || !v.body) { show('Objet et contenu obligatoires.'); return null; }
      const row = { subject: v.subject, body_html: mdToHtml(v.body), body_text: mdToText(v.body), author_id: session.user.id };
      const q = v.id ? sb.from('newsletters').update(row).eq('id', v.id).select('id').single() : sb.from('newsletters').insert(row).select('id').single();
      const { data, error } = await q; if (error) { show(error.message); return null; }
      (f.elements.namedItem('id') as HTMLInputElement).value = data.id; await listNl(); return data.id as string;
    };
    f.addEventListener('submit', async (e) => { e.preventDefault(); if (await save()) show('Brouillon enregistré.', 'ok'); });
    document.getElementById('nlPreview')!.addEventListener('click', () => { prev.innerHTML = mdToHtml(val().body) || '—'; });
    document.getElementById('nlTest')!.addEventListener('click', async () => { const id = await save(); if (!id) return; const r = await postJSON('/api/newsletter-send', { newsletterId: id, test: true }, session.access_token); show(r.ok ? `Test envoyé à ${session.user.email}.` : r.error!, r.ok ? 'ok' : 'err'); });
    document.getElementById('nlSend')!.addEventListener('click', async () => {
      const id = await save(); if (!id) return;
      if (!confirm(`Envoyer « ${val().subject} » à ${st?.confirmes ?? 0} abonné·e·s ? Cette action est définitive.`)) return;
      show('Envoi en cours…', 'info');
      const r = await postJSON<{ sent: number; failed: number }>('/api/newsletter-send', { newsletterId: id }, session.access_token);
      show(r.ok ? `Envoyé à ${r.data.sent} abonné·e·s.${r.data.failed ? ` ${r.data.failed} adresse(s) en échec.` : ''}` : r.error!, r.ok ? 'ok' : 'err'); if (r.ok) { f.reset(); await listNl(); }
    });
    async function listNl() {
