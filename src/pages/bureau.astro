      const row = { title: String(fd.get('title')).trim(), type: String(fd.get('type')), starts_at: paris(date, start), ends_at: end ? paris(date, end) : null, location: String(fd.get('location')).trim(), capacity: fd.get('capacity') ? Number(fd.get('capacity')) : null, description: String(fd.get('description') || '').trim() || null, camps, places_par_camp: camps.length && fd.get('placesParCamp') ? Number(fd.get('placesParCamp')) : null, created_by: session.user.id };
