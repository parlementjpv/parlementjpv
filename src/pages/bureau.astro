        <td>${isAdmin && p.id !== session.user.id && !p.banni ? `<select class="role" data-id="${p.id}">${['membre', 'bureau', 'admin'].map((r) => `<option ${r === p.role ? 'selected' : ''}>${r}</option>`).join('')}</select>` : `<span class="pill">${p.role}</span>`}</td>
        <td>${isAdmin && !p.banni ? `<select class="poste-sel" data-id="${p.id}"><option value="">—</option>${POSTES.map((x) => `<option ${x === p.poste ? 'selected' : ''}>${esc(x)}</option>`).join('')}</select>` : (p.poste ? `<span class="poste-badge" style="margin:0">${esc(p.poste)}</span>` : '')}</td>
        <td>${isAdmin && p.id !== session.user.id ? `<div class="flex" style="gap:6px;flex-wrap:nowrap;">${!p.banni && (p.poste || p.role !== 'membre') ? `<button class="btn btn-outline btn-sm demettre" data-id="${p.id}" type="button">Démettre</button>` : ''}<button class="btn btn-outline btn-sm ban" data-id="${p.id}" data-a="${p.banni ? 'unban' : 'ban'}" type="button">${p.banni ? 'Débannir' : 'Bannir'}</button><button class="btn btn-sm del-user" data-id="${p.id}" type="button">Supprimer</button></div>` : ''}</td></tr>`).join('');
      tbody.querySelectorAll<HTMLButtonElement>('.demettre').forEach((b) => b.addEventListener('click', async () => {
        const p: any = (mems || []).find((x: any) => x.id === b.dataset.id);
        const motif = prompt(`Démettre ${p.prenom} ${p.nom} de ses fonctions${p.poste ? ` (${p.poste})` : ''} ?\n\nIl ou elle perd son poste et l'accès à l'espace bureau, mais reste membre. Un email l'en informe.\n\nMessage à lui transmettre (facultatif) :`, '');
        if (motif === null) return;
        b.disabled = true;
        const r = await postJSON('/api/set-role', { userId: b.dataset.id, action: 'demettre', motif }, session.access_token);
        if (!r.ok) { alert(r.error); b.disabled = false; return; }
        loadMembers();
      }));
      tbody.querySelectorAll<HTMLSelectElement>('.poste-sel').forEach((s0) => s0.addEventListener('change', async () => {
        s0.disabled = true;
        const r = await postJSON<{ ancien: string | null }>('/api/set-role', { userId: s0.dataset.id, poste: s0.value || null }, session.access_token);
        if (!r.ok) alert(r.error); else if (r.data.ancien) alert(`${r.data.ancien} n'est plus ${s0.value} : un poste n'a qu'un titulaire.`);
        loadMembers();
      }));
      tbody.querySelectorAll<HTMLSelectElement>('.role').forEach((s0) => s0.addEventListener('change', async () => {
        const r = await postJSON('/api/set-role', { userId: s0.dataset.id, role: s0.value }, session.access_token);
        if (!r.ok) alert(r.error);
      }));
      tbody.querySelectorAll<HTMLButtonElement>('.del-user').forEach((b) => b.addEventListener('click', async () => {
        const p: any = (mems || []).find((x: any) => x.id === b.dataset.id);
        if (!confirm(`Supprimer définitivement le compte de ${p.prenom} ${p.nom} ?\n\nSon profil, son adhésion, ses candidatures et ses réponses aux événements seront effacés. C'est irréversible.`)) return;
        b.disabled = true;
        const r = await postJSON('/api/admin-user', { userId: b.dataset.id, action: 'delete' }, session.access_token);
        if (!r.ok) { alert(r.error); b.disabled = false; return; }
        loadMembers();
      }));
      tbody.querySelectorAll<HTMLButtonElement>('.ban').forEach((b) => b.addEventListener('click', async () => {
        const p: any = (mems || []).find((x: any) => x.id === b.dataset.id); const ban = b.dataset.a === 'ban';
        if (!confirm(ban ? `Bannir ${p.prenom} ${p.nom} ? Le compte ne pourra plus se connecter et perd ses rôles.` : `Débannir ${p.prenom} ${p.nom} ? Le compte pourra de nouveau se connecter (en simple membre).`)) return;
        b.disabled = true;
        const r = await postJSON('/api/admin-user', { userId: b.dataset.id, action: b.dataset.a }, session.access_token);
        if (!r.ok) { alert(r.error); b.disabled = false; return; }
        loadMembers();
      }));
    }
    await loadMembers();
  })();
</script>
