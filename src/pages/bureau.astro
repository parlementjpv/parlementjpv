---
import Base from '../layouts/Base.astro';
---
<Base title="Espace bureau" noindex>
  <div class="page-head"><div class="container flex between">
    <div><span class="eyebrow">Bureau</span><h1>Tableau de bord</h1></div>
    <a class="btn btn-outline btn-sm" href="/compte">← Mon espace</a>
  </div></div>
  <section class="section" id="app" style="display:none;"><div class="container">
    <div class="stats mb-3">
      <div class="stat"><strong id="sAbo">–</strong><span>abonnés newsletter</span></div>
      <div class="stat"><strong id="sCand">–</strong><span>candidatures à traiter</span></div>
      <div class="stat"><strong id="sMembres">–</strong><span>membres de l'instance</span></div>
      <div class="stat"><strong id="sMsg">–</strong><span>messages non traités</span></div>
    </div>
    <div class="tabs flex mb-3">
      <button class="pill tab active" data-tab="cand" type="button">Candidatures à traiter</button>
      <button class="pill tab" data-tab="archives" type="button">Archives</button>
      <button class="pill tab" data-tab="adh" type="button">Adhésions</button>
      <button class="pill tab" data-tab="nl" type="button">Newsletter</button>
      <button class="pill tab" data-tab="inscr" type="button">Événements</button>
      <button class="pill tab" data-tab="ecrire" type="button">Écrire aux membres</button>
      <button class="pill tab" data-tab="msg" type="button">Messages reçus</button>
      <button class="pill tab" data-tab="membres" type="button">Membres & rôles</button>
    </div>

    <div class="panel" id="tab-cand"><div class="card" style="overflow:auto;"><p class="small muted">Écris d'abord un message (facultatif), puis accepte ou refuse : le candidat reçoit automatiquement un email avec ta réponse et ton message, et la candidature passe dans les archives.</p><div id="candMsg"></div><table class="table" id="candTable"><thead><tr><th>Date</th><th>Candidat·e</th><th>Poste</th><th>Motivation</th><th>Message au candidat</th><th>Décision</th></tr></thead><tbody></tbody></table></div></div>
    <div class="panel hidden" id="tab-archives"><div class="card" style="overflow:auto;"><p class="small muted">Candidatures traitées, conservées. « Rouvrir » la remet dans les candidatures à traiter (sans envoyer d'email).</p><table class="table" id="archTable"><thead><tr><th>Décision</th><th>Candidat·e</th><th>Poste</th><th>Motivation</th><th>Message envoyé</th><th></th></tr></thead><tbody></tbody></table></div></div>

    <div class="panel hidden" id="tab-nl">
      <div class="grid grid-2" style="align-items:start;">
        <div class="card">
          <h3>Rédiger une newsletter</h3>
          <form class="form" id="nlForm">
            <input type="hidden" name="id" />
            <div class="field"><label for="subject">Objet</label><input id="subject" name="subject" required placeholder="ex. Reprise des séances : le programme de septembre" /></div>
            <div class="field"><label for="body">Contenu (Markdown simple)</label><textarea id="body" name="body" required style="min-height:260px;" placeholder="## Titre&#10;Un paragraphe.&#10;- une liste&#10;**gras**, *italique*, [lien](https://…)"></textarea></div>
            <div id="nlMsg"></div>
            <div class="flex">
              <button class="btn btn-outline btn-sm" type="submit">Enregistrer le brouillon</button>
              <button class="btn btn-outline btn-sm" type="button" id="nlPreview">Aperçu</button>
              <button class="btn btn-outline btn-sm" type="button" id="nlTest">M'envoyer un test</button>
              <button class="btn btn-primary btn-sm" type="button" id="nlSend">Envoyer à tous les abonnés</button>
            </div>
          </form>
        </div>
        <div class="grid">
          <div class="card"><h3>Aperçu</h3><div id="preview" class="prose muted small">—</div></div>
          <div class="card"><h3>Numéros</h3><div id="nlList" class="small">—</div></div>
          <div class="card"><h3>Abonnés</h3><div id="subs" class="small">—</div><button class="btn btn-outline btn-sm mt-2" id="exportSubs" type="button">Exporter (CSV)</button></div>
        </div>
      </div>
    </div>

    <div class="panel hidden" id="tab-adh"><div class="card" style="overflow:auto;"><div class="flex between mb-2"><p class="small muted" style="margin:0;">Élèves inscrits via « Rejoindre l'instance ».</p><button class="btn btn-outline btn-sm" id="exportAdh" type="button">Exporter (CSV)</button></div><table class="table" id="adhTable"><thead><tr><th>Date</th><th>Élève</th><th>Classe</th><th>Intérêts</th><th>Message</th></tr></thead><tbody></tbody></table></div></div>
    <div class="panel hidden" id="tab-inscr">
      <div class="grid ev-admin">
        <form class="form card" id="evCreate">
          <h3 id="evFormTitle" style="margin:0;">Créer un nouvel événement</h3>
          <input type="hidden" name="id" />
          <div class="field"><label for="ev-title">Titre</label><input id="ev-title" name="title" required minlength="3" maxlength="140" placeholder="ex. Débat : faut-il abaisser le droit de vote à 16 ans ?" /></div>
          <div class="form-row">
            <div class="field"><label for="ev-type">Type</label><select id="ev-type" name="type"><option>Débat</option><option>Conférence</option><option>Atelier</option><option>Concours</option><option>Visite</option><option>Séance</option><option>Événement</option></select></div>
            <div class="field"><label for="ev-date">Date</label><input id="ev-date" name="date" type="date" required /></div>
          </div>
          <div class="form-row">
            <div class="field"><label for="ev-start">Début</label><input id="ev-start" name="start" type="time" required value="12:00" /></div>
            <div class="field"><label for="ev-end">Fin <small>(facultatif)</small></label><input id="ev-end" name="end" type="time" value="13:00" /></div>
          </div>
          <div class="form-row">
            <div class="field"><label for="ev-loc">Lieu</label><input id="ev-loc" name="location" required maxlength="140" value="Salle Samuel Paty" /></div>
            <div class="field"><label for="ev-cap">Places max <small>(facultatif)</small></label><input id="ev-cap" name="capacity" type="number" min="1" placeholder="illimité" /></div>
          </div>
          <div class="field"><label for="ev-desc">Description <small>(facultatif)</small></label><textarea id="ev-desc" name="description" maxlength="2000" style="min-height:90px;" placeholder="La motion, le format, ce qu'il faut préparer…"></textarea></div>
          <div id="evAdminMsg"></div>
          <div class="flex"><button class="btn btn-primary" type="submit" id="evSave">Publier l'événement</button><button class="btn btn-outline hidden" type="button" id="evCancel">Annuler la modification</button></div>
        </form>
        <div class="card"><h3>Événements et réponses</h3><div id="inscr">—</div></div>
      </div>
    </div>
    <div class="panel hidden" id="tab-ecrire">
      <div class="grid ecrire">
        <div class="card">
          <h3 style="margin-top:0;">1. Choisir les destinataires</h3>
          <input class="input" id="mmSearch" type="search" placeholder="Rechercher un nom, une classe, un email…" />
          <div class="flex mt-1" id="mmFilters" style="gap:6px;"></div>
          <div class="flex between mt-1"><span class="small muted" id="mmCount">0 sélectionné</span><span class="flex" style="gap:6px;"><button class="btn btn-outline btn-sm" id="mmAll" type="button">Tout cocher (liste affichée)</button><button class="btn btn-outline btn-sm" id="mmNone" type="button">Tout décocher</button></span></div>
          <div class="mm-list mt-1" id="mmList"></div>
        </div>
        <form class="card form" id="mmForm">
          <h3 style="margin:0;">2. Écrire le message</h3>
          <div class="field"><label for="mmSubject">Objet</label><input id="mmSubject" required maxlength="200" placeholder="ex. Réunion des orateurs jeudi midi" /></div>
          <div class="field"><label for="mmBody">Message</label><textarea id="mmBody" required maxlength="10000" style="min-height:200px;" placeholder="Le message commence automatiquement par « Bonjour [prénom], » et se termine par ta signature."></textarea></div>
          <p class="small muted" style="margin:0;">Chaque membre reçoit un email personnel envoyé par parlementjpv@gmail.com. Ses réponses arrivent dans cette boîte.</p>
          <div id="mmMsg"></div>
          <button class="btn btn-primary" type="submit" id="mmSend">Envoyer</button>
          <h3 class="mt-2" style="font-size:1.1rem;">Messages envoyés</h3>
          <div id="mmHistory" class="small">—</div>
        </form>
      </div>
    </div>
    <div class="panel hidden" id="tab-msg"><div class="card" style="overflow:auto;"><table class="table" id="msgTable"><thead><tr><th>Date</th><th>De</th><th>Sujet</th><th>Message</th><th></th></tr></thead><tbody></tbody></table></div></div>
    <div class="panel hidden" id="tab-membres"><div class="card" style="overflow:auto;"><p class="small muted">Seul un <strong>admin</strong> peut changer les rôles, bannir ou supprimer un compte. Le rôle « bureau » donne accès à cette page. Un compte banni ne peut plus se connecter.</p><table class="table" id="memTable"><thead><tr><th>Nom</th><th>Classe</th><th>Contact</th><th>Inscrit le</th><th>Rôle</th><th></th></tr></thead><tbody></tbody></table></div></div>
  </div></section>
  <section class="section" id="denied" style="display:none;"><div class="container narrow center"><h2>Accès réservé</h2><p class="muted">Cette page est réservée aux membres du bureau.</p><a class="btn btn-outline" href="/compte">Retour à mon espace</a></div></section>
</Base>
<style>.tab { cursor: pointer; border: 0; font: inherit; font-size: 0.82rem; } .tab.active { background: var(--nuit); color: #fff; } .table select, .table input { font: inherit; font-size: 0.85rem; padding: 4px 6px; border-radius: 6px; border: 1px solid var(--pierre-fonce); } .motiv { max-width: 360px; white-space: pre-wrap; font-size: 0.85rem; }  .ev-admin { grid-template-columns: minmax(300px, 1fr) minmax(320px, 1.2fr); align-items: start; }
  @media (max-width: 900px) { .ev-admin { grid-template-columns: 1fr; } }
  .ev-item { padding: 16px 0; border-bottom: 2px solid var(--pierre-fonce); }
  .ev-item.past { opacity: 0.6; }
  .ev-stats { margin: 8px 0 4px; }
  .ev-stats b { font-size: 1.3rem; color: var(--rouge); }
  .ev-item summary { cursor: pointer; font-weight: 700; font-size: 0.9rem; }
  .ev-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; font-size: 0.88rem; margin-top: 8px; }
  .ev-cols h4 { margin-bottom: 4px; }
  .decide { display: grid; gap: 6px; min-width: 110px; }
  .table textarea { width: 100%; min-width: 180px; font: inherit; font-size: 0.85rem; padding: 6px; border: 2px solid var(--pierre-fonce); }
  #memTable tr.banned td { opacity: 0.55; }
  .ecrire { grid-template-columns: minmax(300px, 1fr) minmax(320px, 1.1fr); align-items: start; }
  @media (max-width: 900px) { .ecrire { grid-template-columns: 1fr; } }
  .mm-list { max-height: 460px; overflow-y: auto; border-top: 2px solid var(--pierre-fonce); }
  .mm-row { display: flex; gap: 10px; align-items: flex-start; padding: 8px 2px; border-bottom: 1px solid var(--pierre-fonce); cursor: pointer; }
  .mm-row input { margin-top: 4px; accent-color: var(--rouge); width: 18px; height: 18px; flex: none; }
  .mm-tag { cursor: pointer; border: 0; font: inherit; font-size: 0.8rem; } .mm-tag.active { background: var(--nuit); color: #fff; }
  .mm-hist { padding: 6px 0; border-bottom: 1px solid var(--pierre-fonce); } .mm-hist summary { cursor: pointer; }
  .del-user { background: var(--rouge); border-color: var(--rouge); }
</style>
<script>
  import { getSupabase } from '../lib/supabase';
  import { requireSession, getProfile } from '../lib/auth';
  import { postJSON } from '../lib/newsletter';
  import { mdToHtml, mdToText } from '../lib/markdown';
  const esc = (s: any) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
  const d = (s: string) => new Date(s).toLocaleDateString('fr-FR');
  (async () => {
    const session = await requireSession(); if (!session) return;
    const sb = getSupabase();
    const me = await getProfile(session.user.id);
    if (!me || !['bureau', 'admin'].includes(me.role)) { document.getElementById('denied')!.style.display = ''; return; }
    document.getElementById('app')!.style.display = '';
    const isAdmin = me.role === 'admin';

    // Tabs
    document.querySelectorAll<HTMLButtonElement>('.tab').forEach((t) => t.addEventListener('click', () => {
      document.querySelectorAll('.tab').forEach((x) => x.classList.remove('active')); t.classList.add('active');
      document.querySelectorAll('.panel').forEach((p) => p.classList.add('hidden'));
      document.getElementById(`tab-${t.dataset.tab}`)!.classList.remove('hidden');
    }));

    // Stats
    const [{ data: st }, { count: nCand }, { count: nMem }, { count: nMsg }] = await Promise.all([
      sb.from('newsletter_stats').select('*').single(),
      sb.from('candidatures').select('*', { count: 'exact', head: true }).in('statut', ['nouvelle', 'en_cours']),
      sb.from('adhesions').select('*', { count: 'exact', head: true }),
      sb.from('contact_messages').select('*', { count: 'exact', head: true }).eq('traite', false),
    ]);
    document.getElementById('sAbo')!.textContent = String(st?.confirmes ?? 0);
    document.getElementById('sCand')!.textContent = String(nCand ?? 0);
    document.getElementById('sMembres')!.textContent = String(nMem ?? 0);
    document.getElementById('sMsg')!.textContent = String(nMsg ?? 0);
    document.getElementById('subs')!.innerHTML = `<strong>${st?.confirmes ?? 0}</strong> confirmés · ${st?.en_attente ?? 0} en attente · ${st?.desinscrits ?? 0} désinscrits`;

    // Candidatures : à traiter / archives
    const STAT: Record<string, string> = { nouvelle: 'Nouvelle', en_cours: 'En cours', acceptee: 'Acceptée', refusee: 'Refusée' };
    const candMsg = document.getElementById('candMsg')!;
    const posteOf = (c: any) => c.type === 'bureau' ? `<strong>${esc(c.poste || 'Tout poste')}</strong>` : '<span class="pill">membre</span>';
    const motivOf = (c: any) => `${esc(c.motivation)}${c.experience ? `<br><em class="muted">Exp. : ${esc(c.experience)}</em>` : ''}${c.disponibilites ? `<br><span class="muted">Dispo : ${esc(c.disponibilites)}</span>` : ''}`;
    const who = (c: any) => `<strong>${esc(c.prenom)} ${esc(c.nom)}</strong><br><span class="muted">${esc(c.classe)}<br><a href="mailto:${esc(c.email)}">${esc(c.email)}</a>${c.profiles?.telephone ? `<br><a href="tel:${esc(c.profiles.telephone)}">${esc(c.profiles.telephone)}</a>` : ''}</span>`;
    async function decide(id: string, statut: string, note?: string) {
      const r = await postJSON<{ emailed: boolean; warning?: string }>('/api/candidature-decision', { id, statut, note }, session.access_token);
      if (!r.ok) { candMsg.innerHTML = `<div class="alert alert-err">${esc(r.error)}</div>`; return false; }
      candMsg.innerHTML = r.data.warning ? `<div class="alert alert-err">${esc(r.data.warning)}</div>` : r.data.emailed ? '<div class="alert alert-ok">Décision enregistrée et email envoyé au candidat. La candidature est dans les archives.</div>' : '';
      return true;
    }
    async function loadCands() {
      const { data: cands } = await sb.from('candidatures').select('*, profiles(telephone)').order('created_at', { ascending: false });
      const open = (cands || []).filter((c: any) => c.statut === 'nouvelle' || c.statut === 'en_cours');
      const done = (cands || []).filter((c: any) => c.statut === 'acceptee' || c.statut === 'refusee').sort((a: any, b: any) => (b.decided_at || b.created_at).localeCompare(a.decided_at || a.created_at));
      document.getElementById('sCand')!.textContent = String(open.length);
      const tb = document.querySelector('#candTable tbody')!;
      tb.innerHTML = open.map((c: any) => `<tr>
        <td>${d(c.created_at)}<br><span class="pill">${STAT[c.statut]}</span></td><td>${who(c)}</td><td>${posteOf(c)}</td><td class="motiv">${motivOf(c)}</td>
        <td><textarea class="note" data-id="${c.id}" rows="3" placeholder="ex. Rendez-vous mardi midi au CDI">${esc(c.note_bureau || '')}</textarea></td>
        <td><div class="decide"><button class="btn btn-primary btn-sm dec" data-id="${c.id}" data-s="acceptee" type="button">Accepter</button><button class="btn btn-outline btn-sm dec" data-id="${c.id}" data-s="refusee" type="button">Refuser</button>${c.statut === 'nouvelle' ? `<button class="btn btn-outline btn-sm dec" data-id="${c.id}" data-s="en_cours" type="button">En cours</button>` : ''}</div></td></tr>`).join('') || '<tr><td colspan="6" class="muted">Aucune candidature à traiter.</td></tr>';
      tb.querySelectorAll<HTMLButtonElement>('.dec').forEach((b) => b.addEventListener('click', async () => {
        const c: any = open.find((x: any) => x.id === b.dataset.id); const s0 = b.dataset.s!;
        const note = (tb.querySelector(`.note[data-id="${b.dataset.id}"]`) as HTMLTextAreaElement).value;
        if (s0 !== 'en_cours' && !confirm(`${s0 === 'acceptee' ? 'Accepter' : 'Refuser'} la candidature de ${c.prenom} ${c.nom} ?\nUn email automatique lui sera envoyé à ${c.email}${note.trim() ? ' avec ton message' : ''}.`)) return;
        b.disabled = true; if (await decide(b.dataset.id!, s0, note)) loadCands(); else b.disabled = false;
      }));
      tb.querySelectorAll<HTMLTextAreaElement>('.note').forEach((t) => t.addEventListener('change', async () => { await sb.from('candidatures').update({ note_bureau: t.value.trim() || null }).eq('id', t.dataset.id); }));
      const ab = document.querySelector('#archTable tbody')!;
      ab.innerHTML = done.map((c: any) => `<tr>
        <td><span class="pill ${c.statut === 'acceptee' ? 'pill-gold' : ''}">${STAT[c.statut]}</span><br><span class="small muted">${c.decided_at ? d(c.decided_at) : ''}</span></td>
        <td>${who(c)}</td><td>${posteOf(c)}</td><td class="motiv">${motivOf(c)}</td><td class="motiv">${esc(c.note_bureau || '—')}</td>
        <td><button class="btn btn-outline btn-sm reopen" data-id="${c.id}" type="button">Rouvrir</button></td></tr>`).join('') || '<tr><td colspan="6" class="muted">Aucune candidature archivée.</td></tr>';
      ab.querySelectorAll<HTMLButtonElement>('.reopen').forEach((b) => b.addEventListener('click', async () => { b.disabled = true; if (await decide(b.dataset.id!, 'en_cours')) loadCands(); }));
    }
    await loadCands();

    // Newsletter
    const f = document.getElementById('nlForm') as HTMLFormElement, nlMsg = document.getElementById('nlMsg')!, prev = document.getElementById('preview')!;
    const show = (t: string, k = 'err') => (nlMsg.innerHTML = `<div class="alert alert-${k}">${t}</div>`);
    const val = () => ({ subject: (f.elements.namedItem('subject') as HTMLInputElement).value.trim(), body: (f.elements.namedItem('body') as HTMLTextAreaElement).value, id: (f.elements.namedItem('id') as HTMLInputElement).value });
    const save = async () => {
      const v = val(); if (!v.subject || !v.body) { show('Objet et contenu obligatoires.'); return null; }
      const row = { subject: v.subject, body_html: mdToHtml(v.body), body_text: mdToText(v.body), author_id: session.user.id };
      const q = v.id ? sb.from('newsletters').update(row).eq('id', v.id).select('id').single() : sb.from('newsletters').insert(row).select('id').single();
      const { data, error } = await q; if (error) { show(error.message); return null; }
      (f.elements.namedItem('id') as HTMLInputElement).value = data.id; await listNl(); return data.id as string;
    };
    f.addEventListener('submit', async (e) => { e.preventDefault(); if (await save()) show('Brouillon enregistré.', 'ok'); });
    document.getElementById('nlPreview')!.addEventListener('click', () => { prev.innerHTML = mdToHtml(val().body) || '—'; });
    document.getElementById('nlTest')!.addEventListener('click', async () => { const id = await save(); if (!id) return; const r = await postJSON('/api/newsletter-send', { newsletterId: id, test: true }, session.access_token); show(r.ok ? `Test envoyé à ${session.user.email}.` : r.error!, r.ok ? 'ok' : 'err'); });
    document.getElementById('nlSend')!.addEventListener('click', async () => {
      const id = await save(); if (!id) return;
      if (!confirm(`Envoyer « ${val().subject} » à ${st?.confirmes ?? 0} abonné·e·s ? Cette action est définitive.`)) return;
      show('Envoi en cours…', 'info');
      const r = await postJSON<{ sent: number; failed: number }>('/api/newsletter-send', { newsletterId: id }, session.access_token);
      show(r.ok ? `Envoyé à ${r.data.sent} abonné·e·s.${r.data.failed ? ` ${r.data.failed} adresse(s) en échec.` : ''}` : r.error!, r.ok ? 'ok' : 'err'); if (r.ok) { f.reset(); await listNl(); }
    });
    async function listNl() {
      const { data } = await sb.from('newsletters').select('id, subject, sent_at, recipients, created_at').order('created_at', { ascending: false }).limit(30);
      document.getElementById('nlList')!.innerHTML = (data || []).map((n) => `<div class="flex between" style="padding:6px 0;border-bottom:1px solid var(--pierre-fonce);"><span>${n.sent_at ? '📨' : '📝'} <strong>${esc(n.subject)}</strong><br><span class="muted">${n.sent_at ? `envoyée le ${d(n.sent_at)} à ${n.recipients}` : `brouillon du ${d(n.created_at)}`}</span></span>${n.sent_at ? `<a class="btn btn-outline btn-sm" href="/newsletter/lire?id=${n.id}">Voir</a>` : `<button class="btn btn-outline btn-sm edit" data-id="${n.id}" type="button">Modifier</button>`}</div>`).join('') || '<span class="muted">Aucun numéro.</span>';
      document.querySelectorAll<HTMLButtonElement>('.edit').forEach((b) => b.addEventListener('click', async () => {
        const { data: n } = await sb.from('newsletters').select('*').eq('id', b.dataset.id).single();
        (f.elements.namedItem('id') as HTMLInputElement).value = n.id; (f.elements.namedItem('subject') as HTMLInputElement).value = n.subject;
        (f.elements.namedItem('body') as HTMLTextAreaElement).value = n.body_text || ''; show('Brouillon chargé (le contenu Markdown d’origine est approximatif).', 'info');
      }));
    }
    await listNl();
    document.getElementById('exportSubs')!.addEventListener('click', async () => {
      const { data } = await sb.from('newsletter_subscribers').select('email, confirmed_at').eq('confirmed', true).is('unsubscribed_at', null);
      const csv = 'email;confirme_le\n' + (data || []).map((s) => `${s.email};${s.confirmed_at?.slice(0, 10) || ''}`).join('\n');
      const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' })); a.download = 'abonnes-newsletter.csv'; a.click();
    });

    // Adhésions
    const { data: adh } = await sb.from('adhesions').select('*').order('created_at', { ascending: false });
    document.querySelector('#adhTable tbody')!.innerHTML = (adh || []).map((a) => `<tr><td>${d(a.created_at)}</td><td><strong>${esc(a.prenom)} ${esc(a.nom)}</strong><br><a href="mailto:${esc(a.email)}">${esc(a.email)}</a>${a.telephone ? `<br><a href="tel:${esc(a.telephone)}">${esc(a.telephone)}</a>` : ''}${a.user_id ? ' <span class="pill">compte</span>' : ''}</td><td>${esc(a.classe)}</td><td>${(a.interets || []).map((i: string) => `<span class="pill">${esc(i)}</span>`).join(' ')}</td><td class="motiv">${esc(a.message || '')}</td></tr>`).join('') || '<tr><td colspan="5" class="muted">Aucune adhésion pour le moment.</td></tr>';
    document.getElementById('exportAdh')!.addEventListener('click', () => {
      const q = (v: unknown) => `"${String(v ?? '').replace(/"/g, '""')}"`;
      const csv = 'date;prenom;nom;classe;email;telephone;interets;message\n' + (adh || []).map((a) => [a.created_at.slice(0, 10), a.prenom, a.nom, a.classe, a.email, a.telephone, (a.interets || []).join(', '), a.message].map(q).join(';')).join('\n');
      const link = document.createElement('a'); link.href = URL.createObjectURL(new Blob(['\ufeff' + csv], { type: 'text/csv' })); link.download = 'adhesions-parlement-jpv.csv'; link.click();
    });

    // Événements : création, modification, réponses
    const evForm = document.getElementById('evCreate') as HTMLFormElement, evMsg = document.getElementById('evAdminMsg')!;
    const evShow = (t: string, k = 'err') => (evMsg.innerHTML = `<div class="alert alert-${k}">${t}</div>`);
    const paris = (date: string, time: string) => { // heure de Paris -> ISO
      const guess = new Date(`${date}T${time}:00Z`);
      const offset = (new Date(guess.toLocaleString('en-US', { timeZone: 'Europe/Paris' })).getTime() - new Date(guess.toLocaleString('en-US', { timeZone: 'UTC' })).getTime()) / 60000;
      return new Date(guess.getTime() - offset * 60000).toISOString();
    };
    const parisParts = (iso: string) => { const f = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Paris', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }).format(new Date(iso)); return { date: f.slice(0, 10), time: f.slice(11, 16) }; };
    const resetEv = () => { evForm.reset(); (evForm.elements.namedItem('id') as HTMLInputElement).value = ''; document.getElementById('evFormTitle')!.textContent = 'Créer un nouvel événement'; document.getElementById('evSave')!.textContent = "Publier l'événement"; document.getElementById('evCancel')!.classList.add('hidden'); };
    document.getElementById('evCancel')!.addEventListener('click', () => { resetEv(); evMsg.innerHTML = ''; });
    evForm.addEventListener('submit', async (e) => {
      e.preventDefault(); if (!evForm.checkValidity()) { evForm.reportValidity(); return; }
      const fd = new FormData(evForm); const id = String(fd.get('id') || '');
      const date = String(fd.get('date')), start = String(fd.get('start')), end = String(fd.get('end') || '');
      if (end && end < start) { evShow("L'heure de fin doit être après l'heure de début."); return; }
      const row = { title: String(fd.get('title')).trim(), type: String(fd.get('type')), starts_at: paris(date, start), ends_at: end ? paris(date, end) : null, location: String(fd.get('location')).trim(), capacity: fd.get('capacity') ? Number(fd.get('capacity')) : null, description: String(fd.get('description') || '').trim() || null, created_by: session.user.id };
      const btn = document.getElementById('evSave') as HTMLButtonElement; btn.disabled = true;
      const { error } = id ? await sb.from('events').update(row).eq('id', id) : await sb.from('events').insert(row);
      btn.disabled = false;
      if (error) { evShow(`Enregistrement impossible : ${error.message}`); return; }
      evShow(id ? 'Événement modifié.' : `Événement publié : il apparaît maintenant sur le site, et les élèves peuvent répondre.`, 'ok');
      resetEv(); await loadEvents();
    });
    async function loadEvents() {
      const [{ data: evs }, { data: regs }] = await Promise.all([
        sb.from('events').select('*').order('starts_at', { ascending: false }),
        sb.from('event_signups').select('event_key, reponse, prenom, nom, classe, email, telephone').order('created_at'),
      ]);
      const by: Record<string, any[]> = {};
      (regs || []).forEach((r: any) => (by[r.event_key] ||= []).push(r));
      const now = Date.now();
      const list = (rows: any[]) => rows.length ? rows.map((p) => `${esc(p.prenom)} ${esc(p.nom)} (${esc(p.classe)}) <a href="mailto:${esc(p.email)}">${esc(p.email)}</a>${p.telephone ? ` · <a href="tel:${esc(p.telephone)}">${esc(p.telephone)}</a>` : ''}`).join('<br>') : '<span class="muted">personne</span>';
      const box = document.getElementById('inscr')!;
      box.innerHTML = (evs || []).map((ev: any) => {
        const rs = by[ev.id] || [], oui = rs.filter((r) => r.reponse === 'oui'), non = rs.filter((r) => r.reponse === 'non');
        const past = new Date(ev.starts_at).getTime() < now;
        return `<div class="ev-item${past ? ' past' : ''}">
          <div class="flex between"><div><span class="pill">${esc(ev.type)}</span> <strong>${esc(ev.title)}</strong><br><span class="small muted">${new Date(ev.starts_at).toLocaleString('fr-FR', { dateStyle: 'full', timeStyle: 'short', timeZone: 'Europe/Paris' })} · ${esc(ev.location)}${past ? ' · passé' : ''}</span></div>
          <div class="flex" style="gap:6px;"><button class="btn btn-outline btn-sm ev-edit" data-id="${ev.id}" type="button">Modifier</button><button class="btn btn-outline btn-sm ev-del" data-id="${ev.id}" type="button">Supprimer</button></div></div>
          <div class="ev-stats"><b>${oui.length}</b> viennent${ev.capacity ? ` / ${ev.capacity} places` : ''} · <b>${non.length}</b> ne viennent pas</div>
          <details><summary>Voir les réponses</summary><div class="ev-cols"><div><h4>Je viens</h4>${list(oui)}</div><div><h4>Je ne viens pas</h4>${list(non)}</div></div>
          ${rs.length ? `<button class="btn btn-outline btn-sm mt-1 ev-csv" data-id="${ev.id}" type="button">Exporter (CSV)</button>` : ''}</details>
        </div>`;
      }).join('') || '<p class="muted">Aucun événement pour l\'instant. Crée le premier avec le formulaire.</p>';
      box.querySelectorAll<HTMLButtonElement>('.ev-del').forEach((b) => b.addEventListener('click', async () => {
        const ev = (evs || []).find((x: any) => x.id === b.dataset.id);
        if (!confirm(`Supprimer « ${ev?.title} » et toutes ses réponses ? C'est définitif.`)) return;
        const { error } = await sb.from('events').delete().eq('id', b.dataset.id);
        if (error) alert(error.message); else loadEvents();
      }));
      box.querySelectorAll<HTMLButtonElement>('.ev-edit').forEach((b) => b.addEventListener('click', () => {
        const ev: any = (evs || []).find((x: any) => x.id === b.dataset.id); if (!ev) return;
        const s0 = parisParts(ev.starts_at), e0 = ev.ends_at ? parisParts(ev.ends_at) : null;
        const set = (n: string, v: string) => ((evForm.elements.namedItem(n) as HTMLInputElement).value = v);
        set('id', ev.id); set('title', ev.title); set('type', ev.type); set('date', s0.date); set('start', s0.time); set('end', e0 ? e0.time : ''); set('location', ev.location); set('capacity', ev.capacity ? String(ev.capacity) : ''); set('description', ev.description || '');
        document.getElementById('evFormTitle')!.textContent = 'Modifier l\'événement'; document.getElementById('evSave')!.textContent = 'Enregistrer les modifications'; document.getElementById('evCancel')!.classList.remove('hidden');
        evMsg.innerHTML = ''; evForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }));
      box.querySelectorAll<HTMLButtonElement>('.ev-csv').forEach((b) => b.addEventListener('click', () => {
        const ev: any = (evs || []).find((x: any) => x.id === b.dataset.id); const rs = by[b.dataset.id!] || [];
        const q = (v: unknown) => `"${String(v ?? '').replace(/"/g, '""')}"`;
        const csv = 'reponse;prenom;nom;classe;email;telephone\n' + rs.map((r: any) => [r.reponse === 'oui' ? 'vient' : 'ne vient pas', r.prenom, r.nom, r.classe, r.email, r.telephone].map(q).join(';')).join('\n');
        const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob(['\ufeff' + csv], { type: 'text/csv' })); a.download = `reponses-${(ev?.title || 'evenement').toLowerCase().replace(/[^a-z0-9]+/g, '-').slice(0, 40)}.csv`; a.click();
      }));
    }
    await loadEvents();

    // Messages
    const { data: msgs } = await sb.from('contact_messages').select('*').order('created_at', { ascending: false }).limit(100);
    const mt = document.querySelector('#msgTable tbody')!;
    mt.innerHTML = (msgs || []).map((m) => `<tr style="${m.traite ? 'opacity:.55' : ''}"><td>${d(m.created_at)}</td><td>${esc(m.nom)}<br><a href="mailto:${esc(m.email)}">${esc(m.email)}</a></td><td>${esc(m.sujet)}</td><td class="motiv">${esc(m.message)}</td><td><button class="btn btn-outline btn-sm done" data-id="${m.id}" type="button">${m.traite ? 'Traité' : 'Marquer traité'}</button></td></tr>`).join('') || '<tr><td colspan="5" class="muted">Aucun message.</td></tr>';
    mt.querySelectorAll<HTMLButtonElement>('.done').forEach((b) => b.addEventListener('click', async () => { await sb.from('contact_messages').update({ traite: true }).eq('id', b.dataset.id); b.textContent = 'Traité'; b.closest('tr')!.style.opacity = '.55'; }));

    // Écrire aux membres
    {
      const { data: people } = await sb.from('adhesions').select('id, prenom, nom, classe, email, interets').order('nom');
      const all = people || [];
      const chosen = new Set<string>();
      let filter = '', tag = '';
      const tags = [...new Set(all.flatMap((a: any) => a.interets || []))].sort();
      const fBox = document.getElementById('mmFilters')!;
      fBox.innerHTML = ['Tous', ...tags].map((t, i) => `<button class="pill mm-tag${i === 0 ? ' active' : ''}" data-t="${i === 0 ? '' : esc(t)}" type="button">${esc(t)}</button>`).join('');
      const visible = () => all.filter((a: any) => (!tag || (a.interets || []).includes(tag)) && (!filter || `${a.prenom} ${a.nom} ${a.classe} ${a.email}`.toLowerCase().includes(filter)));
      const count = () => (document.getElementById('mmCount')!.textContent = `${chosen.size} sélectionné${chosen.size > 1 ? 's' : ''}`);
      const paint = () => {
        const v = visible();
        document.getElementById('mmList')!.innerHTML = v.map((a: any) => `<label class="mm-row"><input type="checkbox" value="${a.id}" ${chosen.has(a.id) ? 'checked' : ''} /><span><strong>${esc(a.prenom)} ${esc(a.nom)}</strong> <span class="muted">${esc(a.classe)}</span><br><span class="small muted">${esc(a.email)}</span></span></label>`).join('') || '<p class="muted small">Aucun membre ne correspond.</p>';
        document.querySelectorAll<HTMLInputElement>('#mmList input').forEach((c) => c.addEventListener('change', () => { c.checked ? chosen.add(c.value) : chosen.delete(c.value); count(); }));
        count();
      };
      document.getElementById('mmSearch')!.addEventListener('input', (e) => { filter = (e.target as HTMLInputElement).value.trim().toLowerCase(); paint(); });
      fBox.querySelectorAll<HTMLButtonElement>('.mm-tag').forEach((b) => b.addEventListener('click', () => { fBox.querySelectorAll('.mm-tag').forEach((x) => x.classList.remove('active')); b.classList.add('active'); tag = b.dataset.t || ''; paint(); }));
      document.getElementById('mmAll')!.addEventListener('click', () => { visible().forEach((a: any) => chosen.add(a.id)); paint(); });
      document.getElementById('mmNone')!.addEventListener('click', () => { chosen.clear(); paint(); });
      paint();
      const mmMsg = document.getElementById('mmMsg')!;
      const loadHistory = async () => {
        const { data } = await sb.from('member_messages').select('subject, sent_count, sender_name, created_at, recipients').order('created_at', { ascending: false }).limit(20);
        document.getElementById('mmHistory')!.innerHTML = (data || []).map((m: any) => `<details class="mm-hist"><summary><strong>${esc(m.subject)}</strong> — ${m.sent_count} destinataire${m.sent_count > 1 ? 's' : ''}, ${new Date(m.created_at).toLocaleString('fr-FR', { dateStyle: 'short', timeStyle: 'short' })} par ${esc(m.sender_name || '?')}</summary><span class="muted">${(m.recipients || []).map(esc).join(', ')}</span></details>`).join('') || '<span class="muted">Aucun message envoyé.</span>';
      };
      loadHistory();
      document.getElementById('mmForm')!.addEventListener('submit', async (e) => {
        e.preventDefault();
        const subject = (document.getElementById('mmSubject') as HTMLInputElement).value.trim(), body = (document.getElementById('mmBody') as HTMLTextAreaElement).value.trim();
        if (!chosen.size) { mmMsg.innerHTML = '<div class="alert alert-err">Coche au moins un destinataire.</div>'; return; }
        if (!subject || !body) { mmMsg.innerHTML = "<div class=\"alert alert-err\">Écris l'objet et le message.</div>"; return; }
        if (!confirm(`Envoyer « ${subject} » à ${chosen.size} membre${chosen.size > 1 ? 's' : ''} par email ?`)) return;
        const btn = document.getElementById('mmSend') as HTMLButtonElement; btn.disabled = true; mmMsg.innerHTML = '<div class="alert alert-info">Envoi en cours…</div>';
        const r = await postJSON<{ sent: number; failed: string[] }>('/api/member-message', { ids: [...chosen], subject, body }, session.access_token);
        btn.disabled = false;
        if (!r.ok) { mmMsg.innerHTML = `<div class="alert alert-err">${esc(r.error)}</div>`; return; }
        mmMsg.innerHTML = `<div class="alert alert-ok">Envoyé à ${r.data.sent} membre${r.data.sent > 1 ? 's' : ''}.${r.data.failed.length ? ` Échec pour : ${r.data.failed.map(esc).join(', ')}.` : ''}</div>`;
        (document.getElementById('mmForm') as HTMLFormElement).reset(); chosen.clear(); paint(); loadHistory();
      });
    }

    // Membres : rôles et bannissement
    async function loadMembers() {
      const [{ data: mems }, { data: adhs }] = await Promise.all([
        sb.from('profiles').select('*').order('created_at', { ascending: false }),
        sb.from('adhesions').select('user_id, email').not('user_id', 'is', null),
      ]);
      const mail = new Map((adhs || []).map((a: any) => [a.user_id, a.email]));
      const tbody = document.querySelector('#memTable tbody')!;
      tbody.innerHTML = (mems || []).map((p: any) => `<tr class="${p.banni ? 'banned' : ''}">
        <td><strong>${esc(p.prenom)} ${esc(p.nom)}</strong>${p.banni ? ' <span class="pill pill-gold">banni</span>' : ''}</td><td>${esc(p.classe || '')}</td>
        <td class="small">${mail.get(p.id) ? `<a href="mailto:${esc(mail.get(p.id))}">${esc(mail.get(p.id))}</a>` : ''}${p.telephone ? `<br><a href="tel:${esc(p.telephone)}">${esc(p.telephone)}</a>` : ''}</td>
        <td>${d(p.created_at)}</td>
        <td>${isAdmin && p.id !== session.user.id && !p.banni ? `<select class="role" data-id="${p.id}">${['membre', 'bureau', 'admin'].map((r) => `<option ${r === p.role ? 'selected' : ''}>${r}</option>`).join('')}</select>` : `<span class="pill">${p.role}</span>`}</td>
        <td>${isAdmin && p.id !== session.user.id ? `<div class="flex" style="gap:6px;flex-wrap:nowrap;"><button class="btn btn-outline btn-sm ban" data-id="${p.id}" data-a="${p.banni ? 'unban' : 'ban'}" type="button">${p.banni ? 'Débannir' : 'Bannir'}</button><button class="btn btn-sm del-user" data-id="${p.id}" type="button">Supprimer</button></div>` : ''}</td></tr>`).join('');
      tbody.querySelectorAll<HTMLSelectElement>('.role').forEach((s0) => s0.addEventListener('change', async () => {
        const r = await postJSON('/api/set-role', { userId: s0.dataset.id, role: s0.value }, session.access_token);
        if (!r.ok) alert(r.error);
      }));
      tbody.querySelectorAll<HTMLButtonElement>('.del-user').forEach((b) => b.addEventListener('click', async () => {
        const p: any = (mems || []).find((x: any) => x.id === b.dataset.id);
        if (!confirm(`Supprimer définitivement le compte de ${p.prenom} ${p.nom} ?\n\nSon profil, son adhésion, ses candidatures et ses réponses aux événements seront effacés. C'est irréversible.`)) return;
        b.disabled = true;
        const r = await postJSON('/api/admin-user', { userId: b.dataset.id, action: 'delete' }, session.access_token);
        if (!r.ok) { alert(r.error); b.disabled = false; return; }
        loadMembers();
      }));
      tbody.querySelectorAll<HTMLButtonElement>('.ban').forEach((b) => b.addEventListener('click', async () => {
        const p: any = (mems || []).find((x: any) => x.id === b.dataset.id); const ban = b.dataset.a === 'ban';
        if (!confirm(ban ? `Bannir ${p.prenom} ${p.nom} ? Le compte ne pourra plus se connecter et perd ses rôles.` : `Débannir ${p.prenom} ${p.nom} ? Le compte pourra de nouveau se connecter (en simple membre).`)) return;
        b.disabled = true;
        const r = await postJSON('/api/admin-user', { userId: b.dataset.id, action: b.dataset.a }, session.access_token);
        if (!r.ok) { alert(r.error); b.disabled = false; return; }
        loadMembers();
      }));
    }
    await loadMembers();
  })();
</script>
