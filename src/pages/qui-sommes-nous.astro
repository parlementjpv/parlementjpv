---
import Base from '../layouts/Base.astro';
import postes from '../data/postes.json';
---
<Base title="Qui sommes-nous" description="Présentation du Parlement JPV : mission, valeurs, organisation, bureau et rôles.">
  <div class="page-head">
    <div class="container">
      <span class="eyebrow">Le Parlement JPV</span>
      <h1>Qui sommes-nous ?</h1>
      <p class="lead">Une initiative lycéenne dédiée à la prise de parole, au débat démocratique et à l'engagement citoyen. Nous organisons des débats, conférences, concours d'éloquence et visites institutionnelles, dans un cadre neutre, ouvert et exigeant.</p>
    </div>
  </div>

  <section class="section">
    <div class="container grid grid-3">
      <div class="card">
        <span class="eyebrow">Objectifs</span>
        <ul class="check">
          <li>Développer la prise de parole et l'esprit critique.</li>
          <li>Apprendre à débattre avec respect, rigueur et écoute.</li>
          <li>Sensibiliser aux enjeux citoyens, culturels et politiques.</li>
          <li>Proposer des activités formatrices : débats, conférences, concours, visites.</li>
        </ul>
      </div>
      <div class="card">
        <span class="eyebrow">Valeurs</span>
        <ul class="check">
          <li>Respect des personnes, des opinions et du cadre scolaire.</li>
          <li>Neutralité : pas de promotion politique, religieuse ou idéologique.</li>
          <li>Ouverture : participation sans barrière inutile.</li>
          <li>Engagement : implication, fiabilité, bienveillance.</li>
        </ul>
      </div>
      <div class="card">
        <span class="eyebrow">Cadre</span>
        <ul class="check">
          <li>Instance sous la responsabilité du CVL, en lien avec une professeure référente.</li>
          <li>Présence d'au moins un adulte requise lors des séances.</li>
          <li>Réunions selon disponibilités (midi / après les cours).</li>
          <li>Matériel du lycée : micros, projecteur, pupitres.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section election">
    <div class="container election-grid">
      <div>
        <span class="eyebrow">Le bureau</span>
        <h2 id="buTitre">Le nouveau bureau est en cours d'élection.</h2>
        <p class="lead" id="buLead">Le bureau 2025-2026 a terminé son mandat. Les candidatures sont ouvertes pour tous les postes : la nouvelle équipe sera présentée ici dès sa désignation.</p>
        <div class="flex mt-3" id="buCta">
          <a class="btn btn-primary" href="/candidature">Candidater au bureau</a>
          <a class="btn btn-outline" href="/candidature#formulaire">Voir le formulaire</a>
        </div>
      </div>
      <div class="seats" aria-label={`${postes.length} postes à pourvoir`}>
        {postes.map((p) => (
          <div class="seat-row" data-poste={p.titre}><span class="dot" aria-hidden="true"></span><span class="seat-poste">{p.titre}</span><span class="state">à pourvoir</span></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Les rôles</span>
      <h2>Qui fait quoi, concrètement</h2>
      <div class="grid grid-3 mt-2">
        <div class="card"><div class="role-k">Président</div><h3>Coordination générale</h3><p class="muted">Anime les séances, fixe l'ordre du jour, arbitre l'organisation et représente le Parlement.</p></div>
        <div class="card"><div class="role-k">Vice-présidence</div><h3>Sécurisation & intérim</h3><p class="muted">Soutien opérationnel : logistique, timing, gestion des imprévus. Assure l'intérim si besoin.</p></div>
        <div class="card"><div class="role-k">Secrétariat</div><h3>Comptes rendus & suivi</h3><p class="muted">Rédige, archive, organise : inscriptions, convocations, documents. Sans suivi, pas de crédibilité.</p></div>
        <div class="card"><div class="role-k">Communication</div><h3>Relais & mobilisation</h3><p class="muted">Fait vivre le Parlement dans le lycée : annonces, recrutement, remontées et coordination terrain.</p></div>
        <div class="card"><div class="role-k">Contenu</div><h3>Préparation & cadrage</h3><p class="muted">Prépare les sujets, structure les séances, propose thèmes et intervenants, garantit la neutralité.</p></div>
        <div class="card"><div class="role-k">Trésorerie</div><h3>Budget & subventions</h3><p class="muted">Budget prévisionnel, suivi des dépenses, demandes MDL / fonds de vie lycéenne.</p></div>
      </div>
      <div class="cta-band mt-4">
        <div><h2>Rejoindre le Parlement JPV</h2><p>Adhésion volontaire : inscription simple, participation aux débats, conférences, ateliers et concours.</p></div>
        <a class="btn btn-primary hide-member" href="/rejoindre">Rejoindre l'instance</a>
      </div>
    </div>
  </section>
</Base>
<script>
  // Le bureau se met à jour tout seul à partir des postes attribués par l'administrateur
  import { getSupabase, supabaseConfigured } from '../lib/supabase';
  import { u } from '../lib/url';
  (async () => {
    if (!supabaseConfigured) return;
    const { data } = await getSupabase().rpc('bureau_public');
    const titulaires = new Map(((data as any[]) || []).map((x) => [x.poste, x]));
    if (!titulaires.size) return;
    const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
    let vacants = 0;
    document.querySelectorAll<HTMLElement>('.seat-row[data-poste]').forEach((row) => {
      const t = titulaires.get(row.dataset.poste);
      const st = row.querySelector('.state')!;
      if (t) { row.classList.add('pourvu'); st.innerHTML = `<strong>${esc(t.prenom)} ${esc(t.nom)}</strong>${t.classe ? ` <span class="seat-cl">${esc(t.classe)}</span>` : ''}`; }
      else vacants++;
    });
    const total = document.querySelectorAll('.seat-row[data-poste]').length;
    document.getElementById('buTitre')!.textContent = vacants ? 'Le bureau se met en place.' : 'Le bureau du Parlement JPV.';
    document.getElementById('buLead')!.textContent = vacants
      ? `${total - vacants} poste${total - vacants > 1 ? 's' : ''} sur ${total} déjà pourvu${total - vacants > 1 ? 's' : ''}. Les candidatures restent ouvertes pour les postes encore libres.`
      : 'Voici les élèves qui font vivre le Parlement cette année. Une question, une idée de séance ? Écris-leur.';
    if (!vacants) document.getElementById('buCta')!.innerHTML = `<a class="btn btn-primary" href="${u('/contact')}">Contacter le bureau</a>`;
  })();
</script>
<style>.role-k { font-size: 0.95rem; color: var(--rouge); font-weight: 700; margin-bottom: 6px; } .member .avatar { object-fit: cover; }  .election { background: var(--pierre); }
  .election-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(28px, 5vw, 72px); align-items: center; }
  .seats { border-top: var(--rule); }
  .seat-row { display: grid; grid-template-columns: 18px 1fr auto; gap: 14px; align-items: center; padding: 12px 0; border-bottom: 2px solid var(--pierre-fonce); font-weight: 700; }
  .seat-row .dot { width: 14px; height: 14px; border-radius: 50%; border: 3px dashed var(--rouge); }
  .seat-row .state { font-weight: 600; font-size: 0.85rem; color: var(--rouge); text-align: right; }
  .seat-row.pourvu .dot { background: var(--rouge); border: 3px solid var(--rouge); }
  .seat-row.pourvu .state { color: var(--nuit); font-size: 1rem; }
  .seat-row :global(.seat-cl) { font-weight: 600; font-size: 0.85rem; color: var(--gris); }
  @media (max-width: 860px) { .election-grid { grid-template-columns: 1fr; } }
</style>
