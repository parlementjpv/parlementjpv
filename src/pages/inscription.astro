---
import Base from '../layouts/Base.astro';
import ClasseChamps from '../components/ClasseChamps.astro';
---
<Base title="Créer un compte et rejoindre l'instance" description="Crée ton compte Parlement JPV pour candidater, t'inscrire aux séances et recevoir la newsletter." noindex>
  <div class="auth-wrap"><div class="card auth-card">
    <span class="eyebrow">Ton compte</span>
    <h1>Rejoindre l'instance</h1>
    <p class="muted small">En créant ton compte, tu deviens membre du Parlement JPV : tu pourras répondre aux événements, candidater au bureau et suivre tes demandes. Réservé aux élèves et personnels du lycée. Un email de confirmation t'est envoyé.</p>
    <form class="form" id="signupForm" novalidate>
      <div class="form-row">
        <div class="field"><label for="prenom">Prénom</label><input id="prenom" name="prenom" required autocomplete="given-name" /></div>
        <div class="field"><label for="nom">Nom</label><input id="nom" name="nom" required autocomplete="family-name" /></div>
      </div>
      <ClasseChamps />
      <div class="form-row">
        <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" required autocomplete="email" /></div>
        <div class="field"><label for="telephone">Téléphone <small>(facultatif)</small></label><input id="telephone" name="telephone" type="tel" autocomplete="tel" inputmode="tel" pattern="[+0-9 .()\-]{8,20}" placeholder="06 12 34 56 78" /></div>
      </div>
      <fieldset class="tags-field">
        <legend>Ce qui t'intéresse <small>(facultatif)</small></legend>
        <div class="tags">
          {['Débats', 'Éloquence', 'Conférences', 'Visites', 'Communication', 'Organisation'].map((i) => <label class="tag"><input type="checkbox" name="interets" value={i} /><span>{i}</span></label>)}
        </div>
      </fieldset>
      <div class="field"><label for="password">Mot de passe</label><input id="password" name="password" type="password" required minlength="8" autocomplete="new-password" /><small>8 caractères minimum.</small></div>
      <label class="checkbox"><input type="checkbox" name="newsletter" checked /><span>Je souhaite recevoir la newsletter (activée dès la confirmation de mon adresse, désinscription à tout moment).</span></label>
      <div class="robot-box">
        <altcha-widget id="altcha" challengeurl={`${import.meta.env.PUBLIC_SUPABASE_URL}/functions/v1/inscription`} hidelogo hidefooter auto="onfocus"
          strings={JSON.stringify({ label: 'Je ne suis pas un robot', verifying: 'Vérification…', verified: 'Vérifié', error: 'La vérification a échoué. Réessaie.', expired: 'La vérification a expiré. Recoche la case.', waitAlert: 'Vérification en cours, patiente un instant.', ariaLinkLabel: 'ALTCHA' })}></altcha-widget>
      </div>
      <label class="checkbox"><input type="checkbox" name="rgpd" required /><span>J'ai lu la <a href="/confidentialite" target="_blank">politique de confidentialité</a> et, si j'ai moins de 15 ans, j'ai l'accord d'un parent.</span></label>
      <div id="msg"></div>
      <button class="btn btn-primary" type="submit">Créer mon compte et rejoindre l'instance</button>
    </form>
    <p class="auth-foot">Déjà un compte ? <a href="/connexion">Se connecter</a></p>
  </div></div>
</Base>
<style is:global>
  .ok-conf { border: 4px solid var(--nuit); padding: 28px; display: grid; gap: 14px; }
  .ok-conf h2 { margin: 0; font-size: clamp(1.8rem, 5vw, 2.6rem); line-height: 1.05; }
  .ok-conf p { margin: 0; font-size: 1.1rem; }
  .ok-spam { color: var(--rouge); font-weight: 800; font-size: 1.2rem !important; }
</style>
<style is:global>
  .robot-box { margin: 4px 0 8px; }
  altcha-widget { --altcha-max-width: 100%; --altcha-border-width: 3px; --altcha-border-radius: 0; --altcha-color-border: var(--nuit); --altcha-color-text: var(--nuit); --altcha-color-base: var(--blanc); --altcha-color-border-focus: var(--rouge); --altcha-color-error-text: var(--rouge); font-family: inherit; }
</style>
<style>
  .tags-field { border: 0; padding: 0; margin: 0; }
  .tags-field legend { font-weight: 700; font-size: 0.95rem; margin-bottom: 8px; }
  .tags-field small { font-weight: 400; color: var(--gris); }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .tag { position: relative; cursor: pointer; }
  .tag input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .tag span { display: inline-block; padding: 6px 11px; border: 2px solid var(--nuit); font-weight: 600; font-size: 0.88rem; }
  .tag input:checked + span { background: var(--nuit); color: #fff; }
  .tag input:focus-visible + span { box-shadow: var(--focus); }
  .auth-card { max-width: 560px; }
</style>
<script>
  import { lireClasse } from '../lib/classe';
  import { u } from '../lib/url';
  import { getSupabase, supabaseConfigured } from '../lib/supabase';
  import { frError, resendBox } from '../lib/auth';
  import { postJSON } from '../lib/newsletter';
  import 'altcha';
  const form = document.getElementById('signupForm') as HTMLFormElement;
  const msg = document.getElementById('msg')!;
  const show = (t: string, k = 'err') => (msg.innerHTML = `<div class="alert alert-${k}">${t}</div>`);
  if (!supabaseConfigured) show('Le serveur d’inscription n’est pas encore configuré (variables Supabase manquantes).', 'info');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) { form.reportValidity(); return; }
    const fd = new FormData(form);
    const btn = form.querySelector('button')!; btn.disabled = true; msg.innerHTML = '';
    const altcha = String(fd.get('altcha') || '');
    if (!altcha) { show('Coche « Je ne suis pas un robot » avant de continuer.'); btn.disabled = false; return; }
    try {
      const r = await postJSON('/api/inscription', {
        action: 'creer', altcha,
        email: String(fd.get('email')).trim(),
        password: String(fd.get('password')),
        redirectTo: `${location.origin}${u('/compte')}?bienvenue=1`,
        data: { prenom: fd.get('prenom'), nom: fd.get('nom'), ...lireClasse(fd), telephone: String(fd.get('telephone')).trim(), interets: fd.getAll('interets').map(String), newsletter: fd.get('newsletter') === 'on' },
      });
      if (!r.ok) { (document.getElementById('altcha') as any)?.reset?.(); throw new Error(r.error); }
      // Newsletter : abonnement activé automatiquement quand l'adresse est confirmée (aucun email séparé)
      try { localStorage.setItem('jpv_compte', '1'); } catch {}
      form.classList.add('hidden');
      const adr = String(fd.get('email')).trim().replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
      msg.innerHTML = `<div class="ok-conf">
        <h2>Merci de confirmer ton adresse email</h2>
        <p>Nous venons d'envoyer un lien de confirmation à <strong>${adr}</strong>. Clique dessus pour activer ton compte.</p>
        <p class="ok-spam">Nos emails arrivent souvent dans les spams : pense à vérifier ce dossier, puis signale l'email comme « Ce n'est pas du spam ».</p>
        ${r.data?.warning ? `<p class="small">${r.data.warning}</p>` : ''}
      </div>`;
      msg.scrollIntoView({ behavior: 'smooth', block: 'start' });
      msg.appendChild(resendBox(String(fd.get('email'))));
    } catch (err: any) {
      show(frError(err.message || String(err)));
      if (/already registered/i.test(err.message || '')) msg.appendChild(resendBox(String(fd.get('email')), "Compte pas encore confirmé ? Renvoyer l'email de confirmation"));
      btn.disabled = false;
    }
  });
</script>
