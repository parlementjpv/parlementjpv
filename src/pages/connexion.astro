---
import Base from '../layouts/Base.astro';
---
<Base title="Connexion" noindex>
  <div class="auth-wrap"><div class="card auth-card">
    <span class="eyebrow">Ton compte</span>
    <h1>Connexion</h1>
    <form class="form" id="loginForm" novalidate>
      <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" required autocomplete="email" /></div>
      <div class="field"><label for="password">Mot de passe</label><input id="password" name="password" type="password" required autocomplete="current-password" /></div>
      <div id="msg"></div>
      <button class="btn btn-primary" type="submit">Se connecter</button>
      <a class="small center" href="/mot-de-passe-oublie">Mot de passe oublié ?</a>
      <div id="resendSlot" class="center"></div>
    </form>
    <p class="auth-foot">Pas encore membre ? <a href="/inscription">Créer mon compte et rejoindre l'instance</a></p>
  </div></div>
</Base>
<script>
  import { u } from '../lib/url';
  import { getSupabase, supabaseConfigured } from '../lib/supabase';
  import { frError, resendBox } from '../lib/auth';
  const form = document.getElementById('loginForm') as HTMLFormElement;
  const msg = document.getElementById('msg')!;
  const show = (t: string, k = 'err') => (msg.innerHTML = `<div class="alert alert-${k}">${t}</div>`);
  if (!supabaseConfigured) show('Le serveur de connexion n’est pas encore configuré.', 'info');
  if (new URLSearchParams(location.search).get('expire')) show('Ta connexion a expiré. Reconnecte-toi pour continuer.', 'info');
  const next = new URLSearchParams(location.search).get('next') || u('/compte');
  supabaseConfigured && getSupabase().auth.getUser().then(({ data }) => { if (data.user) location.href = next; });
  document.getElementById('resendSlot')!.appendChild(resendBox(() => (form.elements.namedItem('email') as HTMLInputElement).value, "Je n'ai pas reçu mon email de confirmation"));
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) { form.reportValidity(); return; }
    const fd = new FormData(form);
    const btn = form.querySelector('button')!; btn.disabled = true; msg.innerHTML = '';
    const { error } = await getSupabase().auth.signInWithPassword({ email: String(fd.get('email')).trim(), password: String(fd.get('password')) });
    if (error) {
      show(frError(error.message)); btn.disabled = false;
      if (/not confirmed/i.test(error.message)) msg.appendChild(resendBox(() => (form.elements.namedItem('email') as HTMLInputElement).value, "Renvoyer l'email de confirmation"));
      return;
    }
    try { localStorage.setItem('jpv_compte', '1'); } catch {}
    location.href = next.startsWith('/') ? next : u('/compte');
  });
</script>
