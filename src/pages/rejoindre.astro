---
import Base from '../layouts/Base.astro';
---
<Base title="Rejoindre" description="Candidater au Parlement JPV : exigences, rôles, engagement, formulaire en ligne.">
  <div class="page-head"><div class="container">
    <span class="eyebrow">Candidatures ouvertes</span>
    <h1>Rejoindre le Parlement JPV</h1>
    <p class="lead">Toute candidature est étudiée par le bureau. Tu es recontacté·e par email, et tu peux suivre son statut depuis ton espace.</p>
  </div></div>
  <section class="section"><div class="container grid grid-2" style="gap:48px;align-items:start;">
    <div>
      <div class="card"><span class="eyebrow">Ce que tu gagnes</span>
        <ul class="check">
          <li>Un niveau d'éloquence et de confiance (feedback exigeant)</li>
          <li>Une méthode d'argumentation (sources, logique, réfutation)</li>
          <li>Des responsabilités réelles (organisation, communication, conférences)</li>
          <li>Une trace officielle (rapports, projets, impact)</li>
          <li>Un vrai plus pour le Grand Oral, Parcoursup et la suite</li>
        </ul>
      </div>
      <div class="card mt-2"><span class="eyebrow">Ce qui est attendu</span>
        <ul class="check">
          <li>Ponctualité et fiabilité</li>
          <li>Travail personnel (préparation, lectures, sources)</li>
          <li>Respect strict du cadre et de la <a href="/charte">charte</a></li>
          <li>Esprit d'équipe</li>
        </ul>
      </div>
    </div>
    <div class="card">
      <h2 style="font-size:1.5rem;">Formulaire de candidature</h2>
      <div id="gate" class="alert alert-info">Pour candidater, <a href="/connexion?next=/rejoindre">connecte-toi</a> ou <a href="/inscription">crée un compte</a> (30 secondes). Ça permet de suivre ta candidature et d'éviter les doublons.</div>
      <form class="form hidden" id="candForm" novalidate>
        <div class="field"><label for="type">Je candidate comme</label>
          <select id="type" name="type"><option value="membre">Membre (débats, conférences, ateliers)</option><option value="mun">Délégué·e JPV MUN</option><option value="bureau">Membre du bureau (rentrée 2027)</option></select>
        </div>
        <div class="form-row">
          <div class="field"><label for="prenom">Prénom</label><input id="prenom" name="prenom" required /></div>
          <div class="field"><label for="nom">Nom</label><input id="nom" name="nom" required /></div>
        </div>
        <div class="form-row">
          <div class="field"><label for="classe">Classe</label><input id="classe" name="classe" required placeholder="ex. 1re 4" /></div>
          <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" required /></div>
        </div>
        <div class="field"><label for="motivation">Pourquoi veux-tu rejoindre le Parlement JPV ?</label><textarea id="motivation" name="motivation" required minlength="80"></textarea><small>Au moins quelques lignes. Sois concret.</small></div>
        <div class="field"><label for="experience">Expérience (facultatif)</label><textarea id="experience" name="experience" style="min-height:80px;" placeholder="Débats, théâtre, concours, MUN, délégué·e de classe…"></textarea></div>
        <div class="field"><label for="dispo">Disponibilités</label><input id="dispo" name="disponibilites" placeholder="ex. lundi et jeudi midi" /></div>
        <label class="checkbox"><input type="checkbox" name="charte" required /><span>Je m'engage à respecter la <a href="/charte" target="_blank">charte du Parlement JPV</a>.</span></label>
        <div id="msg"></div>
        <button class="btn btn-primary" type="submit">Envoyer ma candidature</button>
      </form>
      <div id="done" class="hidden"></div>
    </div>
  </div></section>
</Base>
<script>
  import { getSupabase, supabaseConfigured } from '../lib/supabase';
  import { getSession, getProfile } from '../lib/auth';
  import { postJSON } from '../lib/newsletter';
  const form = document.getElementById('candForm') as HTMLFormElement, gate = document.getElementById('gate')!, msg = document.getElementById('msg')!, done = document.getElementById('done')!;
  (async () => {
    if (!supabaseConfigured) return;
    const session = await getSession(); if (!session) return;
    const sb = getSupabase();
    const { data: existing } = await sb.from('candidatures').select('type, statut, created_at').eq('user_id', session.user.id).order('created_at', { ascending: false }).limit(1);
    gate.classList.add('hidden');
    if (existing && existing.length && existing[0].statut !== 'refusee') {
      done.classList.remove('hidden');
      done.innerHTML = `<div class="alert alert-ok">Tu as déjà déposé une candidature (${existing[0].type}) le ${new Date(existing[0].created_at).toLocaleDateString('fr-FR')} — statut : <strong>${existing[0].statut.replace('_', ' ')}</strong>. Suis-la depuis <a href="/compte">ton espace</a>.</div>`;
      return;
    }
    form.classList.remove('hidden');
    const p = await getProfile(session.user.id);
    (form.elements.namedItem('prenom') as HTMLInputElement).value = p?.prenom || '';
    (form.elements.namedItem('nom') as HTMLInputElement).value = p?.nom || '';
    (form.elements.namedItem('classe') as HTMLInputElement).value = p?.classe || '';
    (form.elements.namedItem('email') as HTMLInputElement).value = session.user.email || '';
    const t = new URLSearchParams(location.search).get('type'); if (t) (form.elements.namedItem('type') as HTMLSelectElement).value = t;
    form.addEventListener('submit', async (e) => {
      e.preventDefault(); if (!form.checkValidity()) { form.reportValidity(); return; }
      const fd = new FormData(form); const btn = form.querySelector('button')!; btn.disabled = true; msg.innerHTML = '';
      const row = { user_id: session.user.id, type: fd.get('type'), prenom: fd.get('prenom'), nom: fd.get('nom'), classe: fd.get('classe'), email: fd.get('email'), motivation: fd.get('motivation'), experience: fd.get('experience') || null, disponibilites: fd.get('disponibilites') || null };
      const { data, error } = await sb.from('candidatures').insert(row).select('id').single();
      if (error) { msg.innerHTML = `<div class="alert alert-err">${error.message}</div>`; btn.disabled = false; return; }
      await postJSON('/api/candidature-notify', { id: data.id }, session.access_token);
      form.classList.add('hidden'); done.classList.remove('hidden');
      done.innerHTML = '<div class="alert alert-ok">Candidature envoyée ! Tu reçois un accusé de réception par email ; le bureau te répond dès que possible.</div>';
    });
  })();
</script>
