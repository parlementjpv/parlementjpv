---
import Base from '../layouts/Base.astro';
import EventList from '../components/EventList.astro';
import LiveEvents from '../components/LiveEvents.astro';
import Reprise from '../components/Reprise.astro';
import data from '../data/events.json';
---
<Base title="Agenda" description="Calendrier des débats, conférences, concours et visites du Parlement JPV.">
  <div class="page-head">
    <div class="container">
      <span class="eyebrow">Séances</span>
      <h1 id="agTitle">Nos séances reprennent très bientôt.</h1>
      <p class="lead">Débats de 30 minutes sur l'heure de midi, conférences, concours d'éloquence et visites. Le nouveau bureau prépare le programme : ajoute l'agenda à ton calendrier, les dates y apparaîtront dès leur annonce.</p>
      <div class="flex mt-2">
        <a class="btn btn-outline btn-sm" href="/agenda.ics" download>Ajouter à mon calendrier (.ics)</a>
        <a class="btn btn-outline btn-sm" href="/#newsletter">Recevoir les rappels par email</a>
      </div>
    </div>
  </div>
  <section class="section">
    <div class="container two-col" style="grid-template-columns: 1fr 1fr;">
      <div>
        <h2>Prochaines séances</h2>
        <LiveEvents><Reprise quoi="nos séances" /></LiveEvents>
      </div>
      <div>
        <h2>Séances passées</h2>
        <LiveEvents mode="past" />
        <EventList events={data.events} past />
      </div>
    </div>
  </section>
</Base>
<script>
  import { fetchUpcoming } from '../lib/events';
  fetchUpcoming().then((evs) => { if (evs.length) document.getElementById('agTitle')!.textContent = 'Les séances du Parlement'; });
</script>
