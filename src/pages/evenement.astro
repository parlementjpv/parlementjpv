---
import Base from '../layouts/Base.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import EventList from '../components/EventList.astro';
import LiveEvents from '../components/LiveEvents.astro';
import data from '../data/events.json';
---
<Base title="Séances" description="Les séances du Parlement JPV : prochains débats, conférences et visites, inscription en ligne et séances passées.">
  <div id="evLoading" class="section"><div class="container"><p class="muted">Chargement des séances…</p></div></div>

  <!-- Aucun événement : message de reprise -->
  <section class="section" id="evEmpty" hidden>
    <div class="container narrow">
      <span class="eyebrow">Séances</span>
      <h1>Nos séances reprennent très bientôt.</h1>
      <p class="lead">Débats de 30 minutes sur l'heure de midi, conférences, concours d'éloquence, visites : le nouveau bureau prépare le programme. Les inscriptions s'ouvriront ici dès la première date annoncée.</p>
      <div class="flex mt-3">
        <a class="btn btn-primary hide-member" href="/rejoindre">Rejoindre l'instance</a>
        <a class="btn btn-outline" href="#passees">Voir les séances passées</a>
      </div>
      <div class="mt-4" style="max-width:520px;"><h2 style="font-size:1.6rem;">Être prévenu par email</h2><NewsletterForm /></div>
    </div>
  </section>

  <!-- Un événement sélectionné -->
  <div id="evMain" hidden>
    <section class="ev-hero">
      <div class="container ev-grid">
        <div class="ev-date" aria-hidden="true"><span class="ev-day" id="evDay"></span><span class="ev-month" id="evMonth"></span></div>
        <div>
          <span class="eyebrow" id="evKicker"></span>
          <h1 id="evTitle"></h1>
          <p class="lead" id="evWhen"></p>
          <p class="ev-desc" id="evDesc" hidden></p>
          <div class="ev-camps" id="evCamps" hidden></div>
          <p class="count" id="evCount" hidden></p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container ev-form-grid">
        <div>
          <h2>Tu viens ?</h2>
          <p class="muted">Ta réponse aide le bureau à prévoir la salle et le temps de parole. Pas besoin de compte ; tes coordonnées ne sont visibles que par le bureau.</p>
          <p class="muted hidden" id="evCampsInfo">Si tu viens, ton camp est <strong>tiré au sort</strong> au moment de ta réponse, en équilibrant les effectifs. Tu le découvres tout de suite après.</p>
          <div class="mon-camp hidden" id="monCamp"></div>
          <div id="evOthers" class="mt-3" hidden><h3 style="font-size:1.2rem;">Les autres séances à venir</h3><div id="evOthersList"></div></div>
        </div>
        <form class="form card" id="evForm" novalidate>
          <fieldset class="answer">
            <legend class="sr-only">Ta réponse</legend>
            <label><input type="radio" name="reponse" value="oui" checked /><span>Je viens</span></label>
            <label><input type="radio" name="reponse" value="non" /><span>Je ne viens pas</span></label>
          </fieldset>
          <div class="form-row">
            <div class="field"><label for="ev-prenom">Prénom</label><input id="ev-prenom" name="prenom" required autocomplete="given-name" maxlength="80" /></div>
            <div class="field"><label for="ev-nom">Nom</label><input id="ev-nom" name="nom" required autocomplete="family-name" maxlength="80" /></div>
          </div>
          <div class="form-row">
            <div class="field"><label for="ev-classe">Classe</label><input id="ev-classe" name="classe" required placeholder="ex. 2nde 3" maxlength="40" /></div>
            <div class="field"><label for="ev-email">Email</label><input id="ev-email" name="email" type="email" required autocomplete="email" /></div>
          </div>
          <div class="field"><label for="ev-tel">Téléphone <small>(facultatif)</small></label><input id="ev-tel" name="telephone" type="tel" autocomplete="tel" inputmode="tel" pattern="[+0-9 .()\-]{8,20}" placeholder="06 12 34 56 78" /></div>
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
          <label class="checkbox"><input type="checkbox" name="rgpd" required /><span>J'accepte que le bureau utilise ces informations pour organiser l'événement (<a class="link" href="/confidentialite" target="_blank">confidentialité</a>) et, si j'ai moins de 15 ans, j'ai l'accord d'un parent.</span></label>
          <div id="evMsg" role="status" aria-live="polite"></div>
          <button class="btn btn-primary" type="submit" id="evSubmit">Envoyer ma réponse</button>
        </form>
      </div>
    </section>
  </div>
  <section class="section seances-passees" id="passees">
    <div class="container">
      <div class="flex between" style="align-items:end;gap:16px;flex-wrap:wrap;">
        <div><span class="eyebrow">Archives</span><h2 style="margin:0;">Séances passées</h2></div>
        <div class="flex" style="gap:8px;"><a class="btn btn-outline btn-sm" href="/agenda.ics" download>Ajouter les séances à mon calendrier</a><a class="btn btn-outline btn-sm" href="/#newsletter">Recevoir les rappels par email</a></div>
      </div>
      <div class="mt-3">
        <LiveEvents mode="past" />
        <EventList events={data.events} past />
      </div>
    </div>
  </section>
</Base>

<style is:global>
  .ev-hero { background: var(--nuit); color: #fff; padding: clamp(48px, 7vw, 96px) 0; }
  :root[data-theme='dark'] .ev-hero { background: #0f1f4b; }
  .ev-hero h1 { color: #fff; max-width: 18ch; }
  .ev-hero .eyebrow { color: #ff6b78; } .ev-hero .eyebrow::before { background: #ff6b78; }
  .ev-hero .lead { color: rgba(255,255,255,0.85); max-width: 40ch; }
  .ev-desc { color: rgba(255,255,255,0.8); max-width: 60ch; white-space: pre-line; }
  .ev-grid { display: grid; grid-template-columns: auto 1fr; gap: clamp(24px, 5vw, 64px); align-items: center; }
  .ev-date { display: grid; justify-items: center; border: 4px solid #fff; padding: 18px 26px 14px; line-height: 0.9; }
  .ev-day { font-size: clamp(5rem, 13vw, 9rem); font-weight: 800; letter-spacing: -0.06em; font-variant-numeric: tabular-nums; }
  .ev-month { font-size: 1.3rem; font-weight: 700; color: #ff6b78; }
  .count { font-weight: 700; color: #fff; }
  .ev-form-grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  .answer { border: 0; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .answer label { position: relative; cursor: pointer; }
  .answer input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .answer span { display: block; text-align: center; padding: 14px; border: 3px solid var(--nuit); font-weight: 800; font-size: 1.1rem; }
  .answer label:first-of-type input:checked + span { background: var(--rouge); border-color: var(--rouge); color: #fff; }
  .answer label:last-of-type input:checked + span { background: var(--nuit); color: #fff; }
  .answer input:disabled + span { opacity: 0.4; cursor: not-allowed; }
  :root[data-theme='dark'] .answer label:last-of-type input:checked + span { background: #f1f3fa; color: #0b142e; }
  .answer input:focus-visible + span { box-shadow: var(--focus); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .hp { position: absolute; left: -9999px; }
  @media (max-width: 760px) { .ev-grid, .ev-form-grid { grid-template-columns: 1fr; } .ev-date { justify-self: start; } }
  .ev-camps { display: flex; flex-wrap: wrap; gap: 8px; margin: 6px 0 14px; }
  .ev-camps span { border: 2px solid rgba(255,255,255,0.7); color: #fff; padding: 5px 12px; font-weight: 700; }
  .ev-camps span b { color: #ff6b78; margin-left: 6px; }
  .mon-camp { border: 4px solid var(--rouge); padding: 18px 20px; margin-top: 18px; }
  .mon-camp small { display: block; color: var(--gris); font-weight: 600; }
  .mon-camp strong { display: block; font-size: 2.2rem; line-height: 1; letter-spacing: -0.03em; color: var(--rouge); margin-top: 4px; }
</style>

<script>
  import { getSupabase } from '../lib/supabase';
  import { getSession, getProfile } from '../lib/auth';
  import { fetchUpcoming, fetchCounts, fmt, when, esc, eventRow, type Ev } from '../lib/events';
  import { u } from '../lib/url';
  import { postJSON } from '../lib/newsletter';

  const $ = (id: string) => document.getElementById(id)!;
  const form = $('evForm') as HTMLFormElement, msg = $('evMsg');
  const show = (t: string, k: 'ok' | 'err' | 'info') => (msg.innerHTML = `<div class="alert alert-${k}">${t}</div>`);

  (async () => {
    const evs = await fetchUpcoming();
    $('evLoading').hidden = true;
    if (!evs.length) { $('evEmpty').hidden = false; return; }
    const wanted = new URLSearchParams(location.search).get('e');
    const ev: Ev = evs.find((e) => e.id === wanted) || evs[0];
    const counts = await fetchCounts();
    const c = counts[ev.id] || { oui: 0, non: 0 };
    const full = ev.capacity ? c.oui >= ev.capacity : false;

    $('evMain').hidden = false;
    $('evDay').textContent = fmt.day(ev.starts_at);
    $('evMonth').textContent = fmt.month(ev.starts_at);
    $('evKicker').textContent = `${ev === evs[0] ? 'Prochain événement' : 'Événement'} · ${ev.type}`;
    $('evTitle').textContent = ev.title;
    $('evWhen').innerHTML = `${esc(fmt.long(ev.starts_at))}, ${when(ev)}<br>${esc(ev.location)}`;
    document.title = `${ev.title} — Parlement JPV`;
    if (ev.description) { $('evDesc').textContent = ev.description; $('evDesc').hidden = false; }
    const showCamp = (camp: string | null | undefined, jeton?: string | null) => {
      const box = $('monCamp');
      if (!camp) { box.classList.add('hidden'); return; }
      box.innerHTML = `<small>Ton camp, tiré au sort</small><strong>${esc(camp)}</strong>${jeton ? `<a class="btn btn-primary btn-sm mt-1" href="${u('/salle')}?t=${jeton}">Entrer dans la salle de mon camp</a><span class="small" style="display:block;margin-top:6px;">Tu as aussi reçu par email toutes les infos et ton lien personnel.</span>` : ''}`; box.classList.remove('hidden');
    };
    const envoyerLien = (jeton?: string | null) => { if (jeton) postJSON('/api/salle-lien', { jeton }).catch(() => {}); };
    if (ev.camps?.length) {
      $('evCamps').innerHTML = ev.camps.map((k) => `<span>${esc(k)}${c.par_camp?.[k] ? `<b>${c.par_camp[k]}</b>` : ''}</span>`).join('');
      $('evCamps').hidden = false; $('evCampsInfo').classList.remove('hidden');
    }
    if (c.oui || ev.capacity) { $('evCount').textContent = `${c.oui} participant${c.oui > 1 ? 's' : ''}${ev.capacity ? ` sur ${ev.capacity} places` : ''}${full ? ' — complet' : ''}`; $('evCount').hidden = false; }
    const others = evs.filter((e) => e.id !== ev.id);
    if (others.length) { $('evOthers').hidden = false; $('evOthersList').innerHTML = others.map((e) => eventRow(e, { counts: counts[e.id] })).join(''); }

    const sb = getSupabase();
    const session = await getSession();
    let existing: { reponse: string; camp?: string | null; jeton?: string | null } | null = null;
    if (session) {
      const p = await getProfile(session.user.id);
      (form.elements.namedItem('prenom') as HTMLInputElement).value = p?.prenom || '';
      (form.elements.namedItem('nom') as HTMLInputElement).value = p?.nom || '';
      (form.elements.namedItem('classe') as HTMLInputElement).value = p?.classe || '';
      (form.elements.namedItem('email') as HTMLInputElement).value = session.user.email || '';
      (form.elements.namedItem('telephone') as HTMLInputElement).value = p?.telephone || '';
      // Consentement déjà donné à la création du compte
      const rg = form.elements.namedItem('rgpd') as HTMLInputElement; rg.checked = true; (rg.closest('label') as HTMLElement).classList.add('hidden');
      const { data } = await sb.from('event_signups').select('reponse, camp, jeton').eq('event_key', ev.id).eq('user_id', session.user.id).maybeSingle();
      existing = data;
      if (existing) {
        (form.querySelector(`input[value=${existing.reponse}]`) as HTMLInputElement).checked = true;
        show(`Tu as déjà répondu : <strong>${existing.reponse === 'oui' ? 'je viens' : 'je ne viens pas'}</strong>. Tu peux changer ta réponse.`, 'info');
        $('evSubmit').textContent = 'Changer ma réponse';
        showCamp(existing.reponse === 'oui' ? existing.camp : null, existing.jeton);
      }
    }
    if (full && existing?.reponse !== 'oui') {
      (form.querySelector('input[value=oui]') as HTMLInputElement).disabled = true;
      (form.querySelector('input[value=non]') as HTMLInputElement).checked = true;
      show('Cet événement est complet. Tu peux tout de même indiquer que tu ne viens pas.', 'info');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      const fd = new FormData(form);
      if (fd.get('website')) return;
      const btn = $('evSubmit') as HTMLButtonElement; btn.disabled = true; show('Envoi…', 'info');
      const reponse = String(fd.get('reponse')) as 'oui' | 'non';
      const prenom = String(fd.get('prenom')).trim();
      const { data: res, error } = await sb.rpc('repondre_evenement', {
        p_event: ev.id, p_reponse: reponse, p_prenom: prenom, p_nom: String(fd.get('nom')).trim(), p_classe: String(fd.get('classe')).trim(),
        p_email: String(fd.get('email')).trim().toLowerCase(), p_telephone: String(fd.get('telephone') || '').trim(),
      });
      btn.disabled = false;
      if (res?.statut === 'complet') { show('Tous les camps sont complets pour cet événement. Tu peux tout de même indiquer que tu ne viens pas.', 'info'); return; }
      if (res?.statut === 'annule') { show('Cet événement a été annulé.', 'info'); return; }
      if (res?.statut === 'deja') { show(`Cette adresse a déjà répondu pour « ${esc(ev.title)} ». Pour changer ta réponse, <a class="link" href="${u('/connexion')}?next=${encodeURIComponent(location.pathname + location.search)}">connecte-toi</a>.`, 'info'); return; }
      if (error || !res) { show("Ta réponse n'a pas pu être enregistrée. Vérifie les champs et réessaie.", 'err'); return; }
      const before = existing?.reponse;
      existing = { reponse, camp: res.camp };
      if (before !== reponse) { if (reponse === 'oui') c.oui++; else if (before === 'oui') c.oui--; }
      if (res.camp) c.par_camp = { ...c.par_camp, [res.camp]: (c.par_camp?.[res.camp] || 0) + (before === 'oui' ? 0 : 1) };
      $('evCount').textContent = `${c.oui} participant${c.oui > 1 ? 's' : ''}${ev.capacity ? ` sur ${ev.capacity} places` : ''}`; $('evCount').hidden = false;
      $('evSubmit').textContent = 'Changer ma réponse';
      showCamp(reponse === 'oui' ? res.camp : null, res.jeton);
      if (reponse === 'oui') envoyerLien(res.jeton);
      const row = { prenom };
      show(reponse === 'oui' ? `C'est noté, ${esc(row.prenom)} : on t'attend le ${esc(fmt.long(ev.starts_at))}${res.camp ? ` dans le camp « ${esc(res.camp)} »` : ''} ! Un email récapitulatif t'a été envoyé.` : `C'est noté, ${esc(row.prenom)}. Merci d'avoir prévenu.`, 'ok');
    });
  })();
</script>
