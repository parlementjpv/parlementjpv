---
import Base from '../layouts/Base.astro';
const photos = [
  { src: '/assets/img/hero.jpg', alt: 'Élève en plein débat' },
  { src: '/assets/img/theo.png', alt: 'Intervention lors d\'un débat' },
  { src: '/assets/img/braulio.png', alt: 'Prise de parole' },
  { src: '/assets/img/pauly.png', alt: 'Échange entre participants' },
  { src: '/assets/img/romaintheo.png', alt: 'Deux membres du Parlement' },
];
---
<Base title="Galerie" description="Photos des débats, conférences et sorties du Parlement JPV.">
  <div class="page-head"><div class="container">
    <span class="eyebrow">Galerie</span>
    <h1>En images</h1>
    <p class="lead">Débats en salle Samuel Paty, concours, visites. Plus de contenus sur <a href="https://instagram.com/parlementjpv" target="_blank" rel="noopener">Instagram</a>.</p>
  </div></div>
  <section class="section"><div class="container">
    <div class="gallery">{photos.map((p) => <img src={p.src} alt={p.alt} loading="lazy" />)}</div>
  </div></section>
</Base>
