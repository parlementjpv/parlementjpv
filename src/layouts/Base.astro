---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  minimal?: boolean; // pas de bandeau ni de footer complet (pages auth)
  article?: { date: string; author: string };
}
const {
  title,
  description = "Parlement JPV — instance lycéenne de débat, d'éloquence et d'engagement citoyen au lycée Jean-Pierre Vernant (Sèvres).",
  image = '/assets/img/og.jpg',
  noindex = false,
  minimal = false,
  article,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = new URL(base + '/', Astro.site).href;
const turnstile = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — Parlement JPV</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/assets/img/favicon-48.png" sizes="48x48" type="image/png" />
  <link rel="icon" href="/assets/img/favicon-96.png" sizes="96x96" type="image/png" />
  <link rel="icon" href="/assets/img/icon-192.png" sizes="192x192" type="image/png" />
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" />
  <meta name="theme-color" content="#0f1f4b" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Parlement JPV" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  {noindex && <meta name="robots" content="noindex" />}
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      { '@type': 'Organization', '@id': `${home}#org`, name: 'Parlement JPV', alternateName: 'Parlement du lycée Jean-Pierre Vernant', url: home,
        logo: new URL(base + '/assets/img/logo.png', Astro.site).href, email: 'contact@parlementjpv.fr',
        description: "Instance lycéenne de débat, d'éloquence et d'engagement citoyen du lycée Jean-Pierre Vernant à Sèvres.",
        address: { '@type': 'PostalAddress', streetAddress: '21 rue du Docteur Ledermann', postalCode: '92310', addressLocality: 'Sèvres', addressCountry: 'FR' },
        parentOrganization: { '@type': 'HighSchool', name: 'Lycée Jean-Pierre Vernant', address: { '@type': 'PostalAddress', addressLocality: 'Sèvres', addressCountry: 'FR' } },
        sameAs: ['https://instagram.com/parlementjpv', 'https://www.linkedin.com/company/parlementjpv/'] },
      { '@type': 'WebSite', '@id': `${home}#site`, url: home, name: 'Parlement JPV', inLanguage: 'fr-FR', publisher: { '@id': `${home}#org` } },
      ...(article ? [{ '@type': 'Article', headline: title, datePublished: article.date, author: { '@type': 'Person', name: article.author }, publisher: { '@id': `${home}#org` }, mainEntityOfPage: canonical.href, inLanguage: 'fr-FR' }] : []),
    ],
  })} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={`${title} — Parlement JPV`} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(import.meta.env.BASE_URL.replace(/\/$/, '') + image, Astro.site)} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="fr_FR" />
  <meta name="twitter:card" content="summary_large_image" />
  <!-- Police hébergée sur le site (aucune requête vers Google) -->
  <link rel="preload" href="/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin />
  <style is:inline set:html={`@font-face{font-family:'Bricolage Grotesque';font-style:normal;font-display:swap;font-weight:200 800;font-stretch:75% 100%;src:url(${base}/fonts/bricolage-grotesque-latin.woff2) format('woff2');}`}></style>
  <script is:inline>
    (function(){try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t);var m=localStorage.getItem('jpv_compte');for(var i=0;i<localStorage.length&&!m;i++){if(/^sb-.*-auth-token$/.test(localStorage.key(i)||''))m='1';}if(m)document.documentElement.classList.add('membre');}catch(e){}})();
  </script>
  <script is:inline define:vars={{ base }}>
    // Application installée : uniquement l'espace membre (pas le site vitrine)
    (function(){var app=false;try{app=window.matchMedia('(display-mode: standalone)').matches||window.navigator.standalone===true||new URLSearchParams(location.search).get('app')==='1';if(app)sessionStorage.setItem('jpv_app','1');else app=sessionStorage.getItem('jpv_app')==='1';}catch(e){}
      if(!app)return;document.documentElement.classList.add('app');
      var p=location.pathname.slice(base.length).replace(/\/+$/,'')||'/';
      var ok=/^\/(compte|profil|motions|elections|tournoi|sondages|sorties|ecrire-au-bureau|salle|bureau|candidature|connexion|inscription|mot-de-passe-oublie|nouveau-mot-de-passe|evenement|application|verifier|charte|confidentialite|mentions-legales)(\/|$)/.test(p);
      if(!ok)location.replace(base+'/compte/');})();
  </script>
  <script is:inline define:vars={{ base }}>
    // Lien d'activation expiré ou déjà utilisé : Supabase renvoie #error=… ; on l'affiche sur la page de connexion
    (function(){var h=location.hash;if(h.indexOf('error_code=')<0&&h.indexOf('error=')<0)return;var p=new URLSearchParams(h.slice(1));var c=p.get('error_code')||p.get('error')||'';if(!c)return;location.replace(base+'/connexion?lien='+encodeURIComponent(c));})();
  </script>
  {turnstile && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</head>
<body>
  <a class="skip-link" href="#main">Aller au contenu</a>
  {!minimal && (
    <div class="notice hide-member">
      Toutes nos actions reprennent très bientôt. Le nouveau bureau est en cours d'élection.
      <a href="/inscription">Rejoindre l'instance</a>
    </div>
  )}
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <script>
    import { refreshAuthUI } from '../lib/auth';
    refreshAuthUI();
  </script>
</body>
</html>
