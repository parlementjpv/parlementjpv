---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  minimal?: boolean; // pas de bandeau ni de footer complet (pages auth)
}
const {
  title,
  description = "Parlement JPV — instance lycéenne de débat, d'éloquence et d'engagement citoyen au lycée Jean-Pierre Vernant (Sèvres).",
  image = '/assets/img/og.jpg',
  noindex = false,
  minimal = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const turnstile = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — Parlement JPV</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/assets/img/favicon.png" type="image/png" />
  <meta name="theme-color" content="#0f1f4b" />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={`${title} — Parlement JPV`} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(import.meta.env.BASE_URL.replace(/\/$/, '') + image, Astro.site)} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="fr_FR" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,300..800&display=swap" rel="stylesheet" />
  <script is:inline>
    (function(){try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t);}catch(e){}})();
  </script>
  {turnstile && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</head>
<body>
  <a class="skip-link" href="#main">Aller au contenu</a>
  {!minimal && (
    <div class="notice">
      Toutes nos actions reprennent très bientôt. Le nouveau bureau est en cours d'élection.
      <a href="/rejoindre">Rejoindre l'instance</a>
    </div>
  )}
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <script>
    import { refreshAuthUI } from '../lib/auth';
    refreshAuthUI();
  </script>
</body>
</html>
