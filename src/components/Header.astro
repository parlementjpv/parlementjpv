---
const links = [
  { href: '/institution', label: 'Le Parlement' },
  { href: '/evenement', label: 'Séances' },
  { href: '/actualites', label: 'Actualités' },
  { href: '/qui-sommes-nous', label: 'Le bureau' },
  { href: '/candidature', label: 'Candidature' },
];
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = Astro.url.pathname.replace(BASE, '').replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/" aria-label="Parlement JPV — accueil">
      <img class="brand-logo" src="/assets/img/icon-192.png" width="40" height="40" alt="" />
      <span>Parlement<br />JPV</span>
    </a>
    <nav class="nav-links" aria-label="Navigation principale">
      {links.map((l) => <a href={l.href} aria-current={current === l.href ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <div class="nav-actions">
      <a class="btn btn-outline btn-sm nav-cta hide-member" href="/inscription">Rejoindre l'instance</a>
      <span class="nav-sep" aria-hidden="true"></span>
      <a class="nav-auth" href="/connexion" data-auth="out">Connexion</a>
      <a class="nav-auth hidden" href="/compte" data-auth="in">Mon espace</a>
      <button class="icon-btn" id="themeToggle" type="button" aria-label="Basculer clair / sombre"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor"/></svg></button>
      <button class="icon-btn burger" id="burger" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobileNav">Menu</button>
    </div>
  </div>
  <nav class="mobile-nav" id="mobileNav" aria-label="Navigation mobile">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    <a href="/charte">Charte</a>
    <a href="/newsletter">Newsletter</a>
    <a href="/contact">Contact</a>
    <a href="/inscription" class="btn btn-outline hide-member">Rejoindre l'instance</a>
  </nav>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--blanc); border-bottom: var(--rule); }
  .nav { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 10px var(--gutter); }
  .brand-logo { display: block; width: 40px; height: 40px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 800; line-height: 0.95; font-size: 1.05rem; letter-spacing: -0.02em; }
  .nav-links { display: flex; gap: 2px; }
  .nav-links a { white-space: nowrap; text-decoration: none; font-weight: 600; padding: 8px 12px; position: relative; }
  .nav-links a::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: 2px; height: 3px; background: var(--rouge); transform: scaleX(0); transform-origin: left; transition: transform 0.15s ease; }
  .nav-links a:hover::after, .nav-links a[aria-current='page']::after { transform: scaleX(1); }
  .nav-actions { display: flex; align-items: center; gap: 12px; }
  .nav-sep { width: 3px; align-self: stretch; margin: 2px 4px; background: var(--pierre-fonce); }
  .nav-auth { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; font-weight: 800; white-space: nowrap; background: var(--rouge); color: #fff; border: 3px solid var(--rouge); padding: 7px 16px; transition: background 0.15s ease, color 0.15s ease; }
  .nav-auth:hover { background: transparent; color: var(--rouge); }
  .nav-auth:focus-visible { outline: 3px solid var(--nuit); outline-offset: 3px; }
  .nav-auth.hidden { display: none; }
  .nav-cta { white-space: nowrap; }
  .icon-btn { display: inline-flex; align-items: center; background: transparent; border: 2px solid var(--nuit); color: var(--nuit); font: inherit; font-weight: 700; padding: 6px 10px; cursor: pointer; }
  .burger { display: none; }
  .mobile-nav { display: none; flex-direction: column; padding: 6px var(--gutter) 20px; border-top: 2px solid var(--pierre-fonce); }
  .mobile-nav a { padding: 12px 0; text-decoration: none; font-weight: 700; font-size: 1.2rem; border-bottom: 2px solid var(--pierre); }
  .mobile-nav .btn { margin-top: 14px; border-bottom: 0; }
  .mobile-nav.open { display: flex; }
  @media (max-width: 1200px) { .nav-links, .nav-cta, .nav-sep { display: none; } .burger { display: inline-block; } .nav-actions { gap: 8px; } }
  @media (max-width: 600px) {
    .nav { gap: 10px; padding-top: 8px; padding-bottom: 8px; }
    .brand { gap: 8px; font-size: 0.92rem; }
    .brand-logo { width: 32px; height: 32px; }
    .nav-actions { gap: 6px; }
    .nav-auth { border-width: 2px; padding: 5px 10px; font-size: 0.85rem; }
    .icon-btn { padding: 5px 8px; font-size: 0.85rem; }
  }
  @media (max-width: 360px) { .brand span { display: none; } }
</style>

<script>
  const root = document.documentElement;
  document.getElementById('themeToggle')?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next); localStorage.setItem('theme', next);
  });
  const burger = document.getElementById('burger'), mobile = document.getElementById('mobileNav');
  burger?.addEventListener('click', () => { const open = mobile?.classList.toggle('open'); burger.setAttribute('aria-expanded', String(!!open)); burger.textContent = open ? 'Fermer' : 'Menu'; });
  if (document.documentElement.classList.contains('app')) { const b = document.querySelector<HTMLAnchorElement>('.site-header .brand'); const h = document.querySelector<HTMLAnchorElement>('.nav-auth[data-auth="in"]'); if (b && h) b.href = h.href; }
</script>
